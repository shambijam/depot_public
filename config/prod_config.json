{
  "project": "SNIPER_X",
  "mode_execution": "DEMO",
  "log_level": "INFO",
  "app": {
    "backup_on_initial_save": false,
    "save_on_initial_load": false,
    "backup_on_update": true,
    "file_permissions_octal": "0o644",
    "audit_log_rotation": {
      "enabled": true,
      "type": "daily",
      "max_files": 30,
      "max_size_mb": 100
    },
    "max_config_backups": 20,
    "context_keys_to_clean_for_logs": [
      "economic_calendar",
      "ai_recommendation_score"
    ]
  },
  "bot_behavior": {
    "cycle_interval_seconds": 5,
    "ai_audit_interval_cycles": 5,
    "news_filter_enabled": false,
    "halt_on_major_news": false,
    "market_phases_enabled": true,
    "min_liquidity_threshold": 0,
    "closed_market_check_bars": 15,
    "trading_start_hour_utc": 7,
    "trading_end_hour_utc": 22,
    "allowed_weekdays": [
      0,
      1,
      2,
      3,
      4
    ],
    "blacklist_durations_by_reason": {
      "low_liquidity": 15,
      "high_spread": 30,
      "market_closed": 120,
      "api_error": 60
    },
    "blacklist_duration_minutes": 60
  },
  "paths": {
    "logs": "logs/",
    "models": "models/",
    "reports": "output/",
    "configs": "config/",
    "strategy_configs": "config/strategy/",
    "asset_configs": "config/assets_config/",
    "prompts": "config/prompts/",
    "phase_observer_config": "config/phase_observer_config.json",
