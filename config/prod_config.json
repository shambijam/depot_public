{
  "project": "SNIPER_X",
  "mode_execution": "DEMO",
  "log_level": "INFO",
  "app": {
    "startup_delay_seconds": 0,
    "status_banner_enabled": true
  },
  "paths": {
    "base_config_dir": "config",
    "strategy_configs": "config/strategy",
    "assets_config": "config/assets",
    "logs": "logs",
    "models": "models",
    "ai_audit": "config/ai_audit",
    "prompts": "config/prompts",
    "broker_accounts_file": "config/broker_accounts.json",
    "env_vars_schema_path": "config/env_vars_schema.json",
    "phase_observer_config_file": "config/phase_observer_config.json",
    "telegram_config_file": "config/telegram_config.json"
  },
  "features": {
    "scalping_phase_observer_enabled": false,
    "liquidity_phase_observer_enabled": true,
    "debug_confidence_logging": false
  },
  "data_collection": {
    "enabled": true,
    "persist_market_snapshots": true,
    "dir": "data"
  },
  "timeframe_mapping": {
    "M1": {
      "mt5_name": "TIMEFRAME_M1",
      "bars_min": 300
    },
    "M5": {
      "mt5_name": "TIMEFRAME_M5",
      "bars_min": 300
    },
    "M15": {
      "mt5_name": "TIMEFRAME_M15",
      "bars_min": 300
    },
    "M30": {
      "mt5_name": "TIMEFRAME_M30",
      "bars_min": 300
    },
    "H1": {
      "mt5_name": "TIMEFRAME_H1",
      "bars_min": 200
    },
    "H4": {
      "mt5_name": "TIMEFRAME_H4",
      "bars_min": 100
    }
  },
  "bot_behavior": {
    "cycle_interval_seconds": 5,
    "allowed_weekdays": [
      0,
      1,
      2,
      3,
      4
    ],
    "trading_start_hour_utc": 7,
    "trading_end_hour_utc": 20
  },
  "ai": {
    "provider": "openai",
    "model_name": "gpt-4o-mini",
    "prompt_settings": {
      "prompts_file_name": "prompts.yaml"
    },
    "audit_mode": {
      "enabled": true,
      "daily_report_enabled": true,
      "daily_report_hour_utc": 20
    }
  },
  "mecano_settings": {
    "performance_log_file_name": "mecano_performance.log",
    "errors_log_file_name": "mecano_errors.log",
    "weekly_report_enabled": false
  },
  "market_regime_detection": {
    "default_vix_index": 20
  },
  "phase_detection_defaults": {
    "default_point_value": 0.00001
  },
  "asset_symbol_mapping": {
    "EURUSD": "EURUSD",
    "GBPUSD": "GBPUSD",
    "XAUUSD": "XAUUSD"
  },
  "guardrails": {
    "volatility": {
      "max_spread_points": 80,
      "max_slippage_points": 50
    },
    "sessions_news": {
      "block_before_minutes": 2,
      "block_after_minutes": 2
    }
  },
  "trade_executor_settings": {
    "audit_trail_file_name": "trade_audit_trail.jsonl",
    "mt5_max_retries": 3,
    "mt5_retry_delay_seconds": 2,
    "fat_finger_check": true,
    "volume_safety_enabled": true,
    "max_absolute_volume_safety": 50.0,
    "allowed_weekdays": [
      0,
      1,
      2,
      3,
      4
    ],
    "trading_start_hour_utc": 7,
    "trading_end_hour_utc": 20,
    "max_allowed_spread_points": 80,
    "execution_policy": {
      "type_filling": "FOK",
      "max_deviation_points": 20
    }
  },
  "mt5_connector_settings": {
    "log_file_name": "mt5_connector.log",
    "trade_history_start_date": "2020-01-01",
    "default_invalid_order_type": "UNKNOWN",
    "min_fixed_volume": 0.01,
    "min_fixed_price": 0.00001,
    "abnormal_profit_threshold": 10000
  },
  "mt5_mappings": {
    "order_types": {
      "BUY": "ORDER_TYPE_BUY",
      "SELL": "ORDER_TYPE_SELL",
      "BUY_LIMIT": "ORDER_TYPE_BUY_LIMIT",
      "SELL_LIMIT": "ORDER_TYPE_SELL_LIMIT",
      "BUY_STOP": "ORDER_TYPE_BUY_STOP",
      "SELL_STOP": "ORDER_TYPE_SELL_STOP"
    },
    "position_types": {
      "BUY": "POSITION_TYPE_BUY",
      "SELL": "POSITION_TYPE_SELL"
    },
    "trade_actions": {
      "DEAL": "TRADE_ACTION_DEAL",
      "PENDING": "TRADE_ACTION_PENDING",
      "MODIFY": "TRADE_ACTION_MODIFY",
      "CLOSE_BY": "TRADE_ACTION_CLOSE_BY"
    },
    "order_filling_policies": {
      "FOK": "ORDER_FILLING_FOK",
      "IOC": "ORDER_FILLING_IOC",
      "RETURN": "ORDER_FILLING_RETURN"
    },
    "order_time_flags": {
      "GTC": "ORDER_TIME_GTC",
      "DAY": "ORDER_TIME_DAY",
      "SPECIFIED": "ORDER_TIME_SPECIFIED"
    },
    "trade_retcodes": {
      "DONE": "TRADE_RETCODE_DONE",
      "PLACED": "TRADE_RETCODE_PLACED",
      "DONE_PARTIAL": "TRADE_RETCODE_DONE_PARTIAL",
      "REQUOTE": "TRADE_RETCODE_REQUOTE",
      "PRICE_CHANGED": "TRADE_RETCODE_PRICE_CHANGED",
      "OFF_QUOTES": "TRADE_RETCODE_OFF_QUOTES",
      "REJECT": "TRADE_RETCODE_REJECT",
      "NO_CHANGES": "TRADE_RETCODE_NO_CHANGES",
      "TOO_MANY_REQUESTS": "TRADE_RETCODE_TOO_MANY_REQUESTS",
      "TIMEOUT": "TRADE_RETCODE_TIMEOUT",
      "TRADE_DISABLED": "TRADE_RETCODE_TRADE_DISABLED",
      "CONNECTION": "TRADE_RETCODE_CONNECTION",
      "NO_CONNECTION": "TRADE_RETCODE_NO_CONNECTION"
    },
    "trade_retcode_actions": {
      "__comment": "Optionnel. Laisser vide si tu ne veux pas forcer de RETRY sur des codes spécifiques."
    },
    "timeframes": {
      "M1": "TIMEFRAME_M1",
      "M5": "TIMEFRAME_M5",
      "M15": "TIMEFRAME_M15",
      "M30": "TIMEFRAME_M30",
      "H1": "TIMEFRAME_H1",
      "H4": "TIMEFRAME_H4"
    }
  },
  "strategies": {
    "default_strategy": "scalping",
    "mapping": {
      "scalping": "config/strategy/config_trade_scalping.json",
      "liquidity": "config/strategy/config_trade_liquidity.json"
    }
  }
}