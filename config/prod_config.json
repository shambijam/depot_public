  "mt5_connector_settings": {
    "log_file_name": "mt5_connector.log",
    "trade_history_start_date": "2020-01-01",
    "enable_console_logging": true,
    "csv_separators_to_test": [
      ";",
      ",",
      "\t"
    ]
