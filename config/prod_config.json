      "EURUSD",
      "GBPUSD",
      "USDJPY",
      "USDCHF"
    ],
    "max_allowed_lot_size": 50.0
  },
  "ai": {
    "enabled": true,
    "model_name": "llama-2-7b-chat.Q4_K_M.gguf",
    "min_confidence": 0.6,
    "apply_recommendation_threshold": 1.1,
    "generation_params": {
      "temperature": 0.7,
      "top_p": 0.9,
      "max_tokens": 2048,
      "ideal_tokens_ratio": 0.75,
      "stop_sequences": [
