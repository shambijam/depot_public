    "backup_dir": "output/backups/",
    "ai_audit": "config/ai_audit/"
  },
  "data_collection": {
    "default_timeframe": "M1",
    "default_bars_count": 500
  },
  "timeframe_mapping": {
    "M1": {
      "mt5_name": "TIMEFRAME_M1",
      "minutes": 1,
      "bars_min": 600,
      "order": 1
    },
    "M5": {
      "mt5_name": "TIMEFRAME_M5",
      "minutes": 5,
      "bars_min": 360,
      "order": 2
    },
    "M15": {
      "mt5_name": "TIMEFRAME_M15",
      "minutes": 15,
      "bars_min": 240,
      "order": 3
    },
    "M30": {
      "mt5_name": "TIMEFRAME_M30",
      "minutes": 30,
      "bars_min": 200,
      "order": 4
    },
    "H1": {
      "mt5_name": "TIMEFRAME_H1",
      "minutes": 60,
      "bars_min": 200,
      "order": 5
    }
  },
  "strategies": {
    "default_strategy": "scalping",
    "config_mapping": {
      "dynamic": "config_trade_dynamic.json",
      "liquidity": "config_trade_liquidity.json",
      "scalping": "config_trade_scalping.json"
    },
    "selection_policy": {
      "winner_takes_all": false,
      "blend_in_range": {
        "enabled": true,
        "market_regimes": [
          "range_low_volatility",
          "range_retail"
        ],
        "primary": "scalping",
        "secondary": "liquidity",
        "weight_primary": 0.7,
        "weight_secondary": 0.3
      }
    }
  },
  "global_safety": {
    "max_open_positions": 10,
    "max_risk_per_trade_percent": 2,
    "max_total_risk_percent": 6,
