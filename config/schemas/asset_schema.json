{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Asset Configuration Schema",
    "type": "object",
    "required": [
        "symbol",
        "type",
        "profile",
        "volatility",
        "risk_management"
    ],
    "properties": {
        "description": {
            "type": "string"
        },
        "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9]{3,10}$"
        },
        "type": {
            "type": "string",
            "enum": [
                "forex",
                "metal",
                "crypto",
                "index",
                "stock"
            ]
        },
        "profile": {
            "type": "string",
            "enum": [
                "institutionnel",
                "retail",
                "test"
            ]
        },
        "last_updated": {
            "type": "string",
            "format": "date"
        },
        "volatility": {
            "type": "object",
            "properties": {
                "expected_daily_range_percent": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number"
                        },
                        "adaptive_range": {
                            "type": "object",
                            "properties": {
                                "min": {
                                    "type": "number"
                                },
                                "max": {
                                    "type": "number"
                                },
                                "adjustment_period_days": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "min",
                                "max"
                            ]
                        }
                    },
                    "required": [
                        "value"
                    ]
                },
                "max_allowed_spread_points": {
                    "type": "object",
                    "properties": {
                        "base": {
                            "type": "number"
                        },
                        "session_multipliers": {
                            "type": "object"
                        },
                        "news_spike_tolerance": {
                            "type": "number"
                        },
                        "volatility_adjustment": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "base"
                    ]
                },
                "min_tradable_range_points": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number"
                        },
                        "dynamic_adjustment": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "value"
                    ]
                }
            },
            "required": [
                "expected_daily_range_percent",
                "max_allowed_spread_points"
            ]
        },
        "risk_management": {
            "type": "object",
            "properties": {
                "base_lot_size": {
                    "type": "number"
                },
                "daily_loss_limit_percent": {
                    "type": "object"
                },
                "weekly_loss_limit_percent": {
                    "type": "object"
                },
                "performance_based_adjustments": {
                    "type": "object"
                }
            },
            "required": [
                "base_lot_size"
            ]
        },
        "strategy_toggles": {
            "type": "object"
        },
        "strategy_whitelist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}