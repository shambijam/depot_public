                "low_vol_percentile": 25
            },
            "volume_profile": {
                "enable_institutional_detection": true,
                "volume_ma_period": 20,
                "institutional_threshold": 1.8
            },
            "regime_types": [
                "trending_institutional_bull",
                "trending_institutional_bear",
                "range_accumulation",
                "range_distribution",
                "high_volatility_chaos",
                "low_volatility_compression"
            ]
        },
        "confidence_score_optimized": {
            "description": "Score de confiance recalibré pour 4 indicateurs",
            "enabled": true,
            "base_confidence": 0.2,
