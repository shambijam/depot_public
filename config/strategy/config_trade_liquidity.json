{
    "strategy_name": "liquidity",
    "version": "2.1",
    "tradeable_assets": [
        "EURUSD",
        "GBPUSD"
    ],
    "magic_number": 51002,
    "risk_per_trade_percent": 0.4,
    "phase_detection": {
        "use_phase_observer": true,
        "lookback_window": 300,
        "volatility_threshold": 0.004,
        "volume_zscore": 1.2
    },
    "liquidity_sweep": {
        "enabled": true,
        "independent": true,
        "ignore_bollinger": true,
        "lookback_bars": 30,
        "max_spread_pips": 5.0,
        "min_atr_m1_pips": 0.25,
        "sweep": {
