{
  "strategy_name": "liquidity",
  "version": "2.0-compat",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "USDCAD",
    "USDCHF"
  ],
  "phase_detection": {
    "use_phase_observer": true,
    "lookback_window": 300,
    "volatility_threshold": 0.004,
    "volume_zscore": 0.35,
    "overrides": {
      "require_range_detection": false,
      "prefer_accumulation_distribution": true,
      "min_lookback_bars": 500
    }
  },
  "magic_number": 51002,
  "risk_per_trade_percent": 0.4,
  "stop_loss_pips": 25,
  "take_profit_pips": 40,
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.004,
      "max_spread_points": 80,
      "min_volume_score": 0.30
    },
    "mtf": {
      "timeframes": [
        "M5",
        "M15",
        "H1"
      ],
      "required_agreements": 2
    },
    "liquidity_signals": {
      "require_sweep_context": false,
      "min_sweep_strength": 0.50,
      "min_displacement_factor": 1.05,
      "min_fvg_size_points": 3,
      "allow_mitigation_entries": true,
      "mitigation_offset_points": 2,
      "invalidate_on_structure_break_against": true
    },
    "scoring": {
      "base_score": 0.80,
      "liquidity_edge_bonus": 0.15,
      "fvg_confluence_bonus": 0.10,
      "mtf_bonus_per_hit": 0.10,
      "best_opportunity_bonus": 0.10,
      "global_low_vol_penalty": -0.10,
      "high_spread_penalty": -0.20
    },
    "filters": {
      "avoid_major_news": true,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true
    },
    "risk": {
      "max_trades_per_day": 4,
      "cooldown_seconds_after_trade": 90,
      "skip_asset_if_spread_over_points": 80
    },
    "execution": {
      "order_type": "limit",
      "limit_use_mitigation": true,
      "slippage_points": 4,
      "max_parallel_positions": 1,
      "fallback_to_market_if_missed": true
    }
  },
  "decision_rules": [
    {
      "name": "baseline_liquidity",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_detected"
        ],
        "phase_must_contain": [
          "range_retail",
          "range_accumulation",
          "trend"
        ],
        "min_confidence": 0.30
      },
      "order_type": "LIMIT",
      "action_logic": {
        "BUY": "place limit at mitigation zone if bullish sweep confirmed",
        "SELL": "place limit at mitigation zone if bearish sweep confirmed"
      }
    }
  ],
  "smart_targets": {
    "take_profit": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 2.0,
      "fallback_rr": 1.5
    },
    "stop_loss": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.2,
      "hard_min_points": 35
    },
    "breakeven": {
      "enabled": true,
      "trigger_rr": 1.0,
      "lock_points": 3
    },
    "partial_take_profit": {
      "enabled": true,
      "at_rr": 1.0,
      "close_percent": 50
    },
    "trailing": {
      "enabled": false,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 2.5
    }
  },
  "exit_rules": {
    "time_based": {
      "enabled": true,
      "max_trade_minutes": 240
    },
    "invalidated_setup": {
      "enabled": true,
      "close_on_break_even_if_reenter": true
    },
    "news_exit": {
      "enabled": true,
      "minutes_before": 2,
      "minutes_after": 2
    }
  }
}