            "swing_window": 5,
            "reference": "recent_high_low",
            "wick_to_body_min_ratio": 1.8,
            "wick_size_min_pips": 2.0,
            "close_back_inside_range": true,
            "volume_spike_sigma": 1.0,
            "allow_gap_sweep": false,
            "min_distance_pips": 1.5
        },
        "absorption": {
            "confirm_candle_required": true,
            "confirm_timeframe": "M1",
            "confirm_max_latency_bars": 2,
            "body_to_range_min": 0.45,
            "closes_through_mid_of_sweep": true
        },
        "entry_logic": {
            "direction": "opposite_of_sweep",
            "trigger": "break_of_absorption_extreme",
            "buffer_pips": 0.4,
            "timeout_bars": 3,
            "prefer_confluent_zone": true,
            "use_wick_fill": false,
            "wick_fill_ratio": 0.5,
            "use_mtf_zone": false,
            "retracement_tolerance_pips": 3.0
        },
        "risk_filters": {
            "mtf_bias_timeframe": "M5",
            "align_with_mtf_bias": true,
            "max_consecutive_signals": 2,
            "min_distance_to_round_number_pips": 1.5
        }
    },
    "decision_engine": {
        "thresholds": {
            "min_volatility": 0.004,
            "max_spread_points": 80,
            "min_volume_score": 0.3
        },
        "mtf": {
            "timeframes": [
                "M5",
                "M15",
                "H1"
            ],
            "required_agreements": 2
        }
    },
    "mtf": {
        "timeframes": [
            "M5",
            "M15",
            "H1"
        ],
        "required_agreements": 2
    },
    "scoring": {
        "base_score": 0.8,
        "liquidity_edge_bonus": 0.15,
        "fvg_confluence_bonus": 0.1,
        "mtf_bonus_per_hit": 0.1,
        "global_low_vol_penalty": -0.1,
        "high_spread_penalty": -0.2
    },
    "filters": {
        "avoid_major_news": true,
        "disable_on_weekends": true,
        "allow_only_whitelist_assets": true
    },
    "risk": {
        "max_trades_per_day": 4,
        "cooldown_seconds_after_trade": 90
    },
    "execution": {
        "order_type": "limit",
        "limit_use_mitigation": true,
        "slippage_points": 4,
        "max_parallel_positions": 1
    },
    "confidence_score_calculation": {
        "liquidity_weights": {
            "sweep_detected": 0.35,
            "absorption_confirmed": 0.25,
            "eqh_eql_detected": 0.2
        },
        "signal_weights": {
            "fvg_detected": 0.25,
            "ob_detected": 0.35,
            "bos_mss_detected": 0.25,
            "regime_alignment": 0.15,
            "candle_pattern": 0.15
        },
        "confluence_bonus": {
            "fvg_ob_confluence": 0.15,
            "ob_bos_confluence": 0.1,
            "full_confluence_bonus": 0.2
        },
        "quality_factors": {
            "tight_spread": 1.05,
            "regime_strength": 1.1,
            "high_volume_confirmation": 1.15
        },
        "bollinger_weights": {
            "mean_revert_score": 0.1,
            "breakout_score": 0.1,
            "squeeze_bonus": 0.05,
            "expansion_bonus": 0.05
        },
        "base_confidence": 0.2,
        "max_confidence_cap": 0.95
    },
    "exit_rules": {
        "time_based": {
            "enabled": true,
            "max_trade_minutes": 240
        },
        "invalidated_setup": {
            "enabled": true,
            "close_on_break_even_if_reenter": true
        },
        "news_exit": {
            "enabled": true,
            "minutes_before": 2,
            "minutes_after": 2
        },
        "liquidity_exit": {
            "max_bars_in_trade": 50,
            "volume_exit_threshold": 3.0,
            "trailing_structure": {
                "enabled": true
            }
        }
    },
    "decision_rules": [
        {
            "name": "liquidity_entry",
            "priority": 1,
            "conditions": {
                "min_confidence": 0.30
            },
            "order_type": "MARKET",
            "action_logic": {
                "BUY": "enter_on_liquidity_sweep_low",
                "SELL": "enter_on_liquidity_sweep_high"
            }
        }
