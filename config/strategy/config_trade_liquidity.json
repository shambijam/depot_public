{
    "strategy_name": "liquidity",
    "version": "3.0",
    "description": "Liquidity strategy — SL/TP engine, no trailing, no candle-pattern rules",
    "tradeable_assets": [
        "EURUSD",
        "GBPUSD",
        "XAUUSD"
    ],
    "magic_number": 53001,
    "confidence_threshold": 0.25,
    "global_safety": {
        "max_open_positions": 5
    },
    "execution_policy": {
        "max_spread_points": 60
    },
    "phase_detection": {
        "use_phase_observer": false,
        "allowed_phases": [
            "liquidity_eqh_eql",
            "range_retail",
            "transitional"
        ],
        "lookback_window": 24,
        "volatility_threshold": 0.0,
        "volume_zscore": 0.0,
        "eq_level_tolerance": 0.0,
        "impulse_threshold": 0.0
    },
    "entry_rules": {
        "liquidity": {
            "enabled": true,
            "eqh_eql_break": {
                "enabled": true,
                "lookback_bars": 120,
                "threshold_points": 0.0,
                "min_distance_points": 0.0
            },
            "range_accumulation": {
                "enabled": true,
                "max_range_pips": 60,
                "min_consolidation_bars": 10
            }
        }
    },
    "exit_rules": {
        "managed_by": "sltp",
        "time_based": {
            "enabled": true,
            "max_trade_minutes": 240
        },
        "invalidated_setup": {
            "enabled": true,
            "close_on_break_even_if_reenter": true
        },
        "news_exit": {
            "enabled": true,
            "minutes_before": 2,
            "minutes_after": 2
        },
        "liquidity_exit": {
            "max_bars_in_trade": 50,
            "volume_exit_threshold": 3.0
        }
    },
    "cooldown_after_exit_s": 10,
    "risk": {
        "position_size": "risk_based",
        "max_positions_per_symbol": 2,
        "stop_distance_pips": 60
    },
    "smart_sl_tp_settings": {
        "sl_placement_method": "PIPS",
        "tp_placement_method": "RR",
        "tp_rr_ratio": 1.8,
        "sl_atr_period": 14,
        "sl_atr_multiplier": 1.2,
        "tp_atr_period": 14,
        "tp_atr_multiplier": 2.2,
        "sl_swing_lookback_period": 10,
        "sl_buffer_pips": 2,
        "take_profit_pips": 90,
        "stop_loss_pips": 60
    },
    "smart_targets": {
        "stop_loss": {
            "hard_min_points": 0,
            "hard_max_points": 100000
        },
        "take_profit": {
            "hard_max_points": 200000
        }
    },
    "decision_rules": [
        {
            "name": "liquidity_entry",
            "priority": 1,
            "conditions": {
                "min_confidence": 0.25
            },
            "order_type": "MARKET",
            "action_logic": {
                "BUY": "enter_on_liquidity_signal",
                "SELL": "enter_on_liquidity_signal"
            }
        }
    ]
}