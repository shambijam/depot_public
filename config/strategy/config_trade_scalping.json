      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.30
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 2.0,
        "close_edge_frac": 0.25
      }
    },
    "patterns": {
      "enabled": false,
      "inside_bar": {
        "breakout_buffer_pips": 1.2
      }
    },
    "range_accumulation": {
      "enabled": false
    },
    "range_accumulation_mtf": {
      "enabled": false
