{
  "strategy_name": "scalping",
  "version": "2.5-katana-micro-nogate",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "USDCAD",
    "USDCHF"
  ],
  "magic_number": 51001,
  "phase_detection": {
    "range_sensitivity": 0.55,
    "low_vol_window": 100,
    "low_vol_percentile": 0.15,
    "atr_period": 14,
    "min_bars": 200,
    "std_mult": 2.0,
    "squeeze_window": 100,
    "squeeze_percentile": 0.15,
    "lookback_window": 200,
    "volatility_threshold": 0.0001,
    "volume_zscore": 1.2
  },
  "decision_rules": [
    {
      "name": "range_scalping_microbreak",
      "priority": 2,
      "conditions": {
        "signal_must_contain": [
          "ob_detected"
        ],
        "phase_must_contain": [
          "range",
          "range_retail",
          "range_low_volatility"
        ],
        "min_confidence": 0.60
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish micro-break with OB confluence and spread <= max_spread_pips",
        "SELL": "enter on bearish micro-break with OB confluence and spread <= max_spread_pips"
      }
    },
    {
      "name": "range_midline_scalping",
      "priority": 3,
      "conditions": {
        "phase_must_contain": [
          "range",
          "range_low_volatility",
          "range_retail"
        ],
        "min_confidence": 0.3,
        "requires": {
          "is_range": true,
          "mid_entry": [
            "buy",
            "sell"
          ],
          "mid_entry_score_min": 0.55,
          "range_score_min": 0.62
        }
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if mid_entry == 'buy' and spread <= max_spread_pips",
        "SELL": "enter if mid_entry == 'sell' and spread <= max_spread_pips"
      }
    },
    {
      "name": "liquidity_sweep_absorption",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "liquidity_sweep",
          "absorption_confirmed"
        ],
        "min_confidence": 0.3
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "take opposite of bearish sweep after absorption confirmation",
        "SELL": "take opposite of bullish sweep after absorption confirmation"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "boll_midline": {
        "strict_mode": false,
        "min_rr": 1.5,
        "tp_halfband_k": 0.60,
        "buffer_pips_min": 0.65,
        "min_mid_distance_ratio": 0.15,
        "require_range_regime": true,
        "block_on_expansion": false,
        "min_confidence": 0.45,
        "fvg_max_distance_pips": 1.8,
        "ob_max_distance_pips": 1.8,
        "katana_soft_distance_mult": 1.25,
        "min_atr_m1_pips": 0.15,
        "max_spread_pips": 2.2,
        "max_stop_pips_scalp": 8.0,
        "reject_if_sl_over_cap": true,
        "m1_break_bonus": 0.12,
        "only_trade_at_range_edges": false,
        "allow_midline_entries": true,
        "mid_entry_score_min": 0.55,
        "range_score_min": 0.62,
        "range_debounce_bars": 3
      },
      "atr_filter": {
        "enabled": true,
        "min_atr_pips": 4.0
      },
      "liquidity_sweep": {
        "independent": true,
        "ignore_bollinger": true,
        "max_spread_pips": 5.0,
        "min_atr_m1_pips": 0.04,
        "lookback_bars": 30,
        "sweep": {
          "use_swings": true,
          "swing_window": 5,
          "reference": "recent_high_low",
          "wick_to_body_min_ratio": 1.8,
          "wick_size_min_pips": 2.0,
          "close_back_inside_range": true,
          "volume_spike_sigma": 1.0,
          "allow_gap_sweep": false
        },
        "absorption": {
          "confirm_candle_required": true,
          "confirm_timeframe": "M1",
          "confirm_max_latency_bars": 2,
          "body_to_range_min": 0.45,
          "closes_through_mid_of_sweep": true
        },
        "entry_logic": {
          "direction": "opposite_of_sweep",
          "trigger": "break_of_absorption_extreme",
          "buffer_pips": 0.4,
          "timeout_bars": 3
        },
        "risk_filters": {
          "mtf_bias_timeframe": "M5",
          "align_with_mtf_bias": true,
          "max_consecutive_signals": 2,
          "min_distance_to_round_number_pips": 1.5
        }
      }
    }
  },
  "execution_quality_filters": {
    "atr_volatility_filter": {
      "enabled": true,
      "period": 14,
      "min_atr": 0.0,
      "max_atr": 1000000000.0
    }
  },
  "risk_limits": {
