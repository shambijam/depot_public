{
  "strategy_name": "scalping",
  "description": "Scalping Burst — trailing-only exits (no TP). Dynamic SL/Trailing driven by ATR with broker-aware floors.",
  "version": "4.0-dynamic",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "confidence_threshold": 0.2,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.2
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 8,
        "enforce_single_basket": false,
        "per_leg_virtual": false,
        "sltp": {
          "sl_method": "ATR",
          "rr_base": 1.9,
          "rr_floor": 1.2,
          "rr_cap": 3.0,
          "sl": {
            "atr_period": 14,
            "atr_multiplier": 2.8,
            "buffer_pips": 8,
            "swing_lookback": 10,
            "pips": 70
          },
          "tp": {
            "tp_method": "RR",
            "atr_period": 14,
            "atr_multiplier": 2.8,
            "pips": 100,
            "execution": {
              "min_sl_tp_distance_pips": 11.0
            }
          }
        }
      },
      "trailing": {
        "enabled": true,
        "activation": {
          "mode": "ATR",
          "atr_period": 14,
          "atr_multiple": 1.1,
          "min_pips": 4.0
        },
        "step": {
          "mode": "ATR",
          "atr_multiple": 0.40,
          "min_pips": 2.0,
          "update_interval_ms": 600
        },
        "break_even": {
          "enabled": true,
          "trigger": {
            "mode": "ATR",
            "atr_multiple": 1.0,
            "min_pips": 3.0
          },
          "offset_pips": 2.0
        },
        "broker_floors": {
          "min_sl_distance_pips": 2.0,
          "spread_multiplier": 2.0,
          "extra_buffer_pips": 1.0
        }
      },
      "closure_rules": {
        "enabled": false,
        "enable_profit_close": false,
        "enable_loss_guard": false,
        "require_full_count_for_profit_close": true,
        "require_all_seen_green_once": true,
        "all_seen_green_pips": 3.0,
        "min_green_pnl_pips": 1.0,
        "rt_fast_window_ms": 0,
        "rt_poll_interval_ms": 120,
        "max_loss_pips": 15.0,
        "loss_guard_arming_ms": 3000,
        "min_age_ms_for_any_close": 3000
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp",
    "use_trailing_stop": true
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "liquidity_eqh_eql",
      "range_retail",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "risk_per_trade_percent": 0.73,
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 60
  },
  "trade_executor_settings": {
    "version": "3.0",
    "fat_finger_check": {
      "enabled": true,
      "policy": "FLOOR",
      "max_absolute_volume_for_asset": {
        "XAUUSD": 1.5
      }
    },
    "halt_on_major_news": false
  },
  "fusion": {
    "adaptive_weights": true,
    "seuils_entree": {
      "min_confidence": 0.65,
      "min_orderflow_score": 60,
      "max_spread_pts": 15
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "direct": 0.70,
      "conditional": 0.50
    },
    "momentum": {
      "breakout": {
        "lookback_bars": 30,
        "atr_period": 14,
        "max_width_over_atr": 1.4,
        "breakout_buffer_frac": 0.10
      },
      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.25
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 1.8,
        "close_edge_frac": 0.20
      }
    },
    "patterns": {
      "inside_bar": {
        "breakout_buffer_pips": 1.0
      }
    },
    "ponderations": {
      "trigger_weight": 0.50,
      "orderflow_weight": 0.30,
      "footprint_weight": 0.20,
      "coherence_bonus_max": 0.15
    },
    "regles_metier": {
      "veto_absorption": true,
      "never_against_strong_orderflow": true,
      "triple_confirmation_bonus": true,
      "weak_footprint_score_th": 0.60
    },
    "base_trail_steps": 20
  },
  "smart_sl_tp_settings": {
    "DEPRECATION_NOTE": "Legacy fallback – kept for compatibility until code reads only the dynamic block.",
    "sl_placement_method": "ATR",
    "sl_atr_period": 14,
    "sl_atr_multiplier": 2.2,
    "sl_buffer_pips": 6,
    "tp_placement_method": "RR",
    "tp_rr_ratio": 1.6,
    "tp_atr_period": 14,
    "tp_atr_multiplier": 2.0,
    "sl_swing_lookback_period": 10,
    "stop_loss_pips": 70,
    "take_profit_pips": 100
  },
  "smart_targets": {
    "risk_management": {
      "default_equity": 10000
    },
    "stop_loss": {
      "hard_min_points": 0,
      "hard_max_points": 100000
    },
    "take_profit": {
      "hard_max_points": 200000
    }
  }
}