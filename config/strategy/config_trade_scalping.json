{
  "strategy_name": "scalping",
  "version": "2.0-compat",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "XAUUSD",
    "NAS100"
  ],
  "phase_detection": {
    "use_phase_observer": true,
    "overrides": {
      "require_range_detection": true,
      "min_lookback_bars": 500
    }
  },
  "magic_number": 51001,
  "risk_per_trade_percent": 0.5,
  "stop_loss_pips": 20,
  "take_profit_pips": 30,
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.010,
      "max_spread_points": 50,
      "min_volume_score": 0.50
    },
    "mtf": {
      "timeframes": [
        "M1",
        "M5",
        "M15"
      ],
      "required_agreements": 2
    },
    "scoring": {
      "base_score": 0.80,
      "strategy_bias": 0.30,
      "liquidity_bonus": 0.10,
      "mtf_bonus_per_hit": 0.10,
      "best_opportunity_bonus": 0.15,
      "global_low_vol_penalty": -0.20,
      "high_spread_penalty": -0.30
    },
    "filters": {
      "avoid_major_news": true,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true
    },
    "risk": {
      "max_trades_per_day": 6,
      "cooldown_seconds_after_trade": 60,
      "skip_asset_if_spread_over_points": 50
    },
    "execution": {
      "order_type": "market",
      "slippage_points": 3,
      "max_parallel_positions": 1
    }
  },
  "decision_rules": [
    {
      "name": "baseline_scalping",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_ob_confluence"
        ],
        "phase_must_contain": [
          "trend",
          "range_retail",
          "range_accumulation"
        ],
        "min_confidence": 0.30
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if bullish confluence and spread <= max_spread_points",
        "SELL": "enter if bearish confluence and spread <= max_spread_points"
      }
    }
  ],
  "smart_targets": {
    "take_profit": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.5,
      "fallback_rr": 1.2
    },
    "stop_loss": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.0,
      "hard_min_points": 30
    },
    "breakeven": {
      "enabled": true,
      "trigger_rr": 1.0,
      "lock_points": 2
    },
    "partial_take_profit": {
      "enabled": true,
      "at_rr": 1.0,
      "close_percent": 50
    },
    "trailing": {
      "enabled": false,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 2.0
    }
  },
  "exit_rules": {
    "time_based": {
      "enabled": true,
      "max_trade_minutes": 120
    },
    "invalidated_setup": {
      "enabled": true,
      "close_on_break_even_if_reenter": false
    },
    "news_exit": {
      "enabled": true,
      "minutes_before": 2,
      "minutes_after": 2
    }
  }
}
