{
  "strategy_name": "scalping",
  "description": "DEMO EASY — Scalping Burst géré par Fusion (Orderflow + Footprint + Trigger). TP désactivé, sorties uniquement au trailing. Aucune barrière bloquante.",
  "version": "4.3-demo-easy",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.05
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 5,
        "enforce_single_basket": true,
        "per_leg_virtual": false,
        "sltp": {
          "sl_method": "SWING",
          "rr_base": 1.8,
          "rr_floor": 1.2,
          "rr_cap": 3.0,
          "sl": {
            "atr_period": 14,
            "atr_multiplier": 3.0,
            "swing_lookback": 25,
            "pips": 400,
            "buffer_pips": 2
          },
          "tp": {
            "tp_method": "NONE",
            "atr_period": 14,
            "atr_multiplier": 3.0,
            "pips": 400,
            "execution": {
              "min_sl_tp_distance_pips": 10
            }
          }
        }
      },
      "trailing": {
        "enabled": true,
        "activation": {
          "mode": "PIPS",
          "min_pips": 23.0,
          "atr_period": 14,
          "atr_multiple": 6.0
        },
        "step": {
          "mode": "PIPS",
          "min_pips": 8.0,
          "atr_multiple": 1.10,
          "update_interval_sec": 2.0
        },
        "break_even": {
          "enabled": false,
          "trigger": {
            "mode": "PIPS",
            "min_pips": 9999.0
          },
          "offset_pips": 0.0
        },
        "broker_floors": {
          "min_sl_distance_pips": 6.0,
          "spread_multiplier": 2.5,
          "extra_buffer_pips": 1.0
        }
      },
      "closure_rules": {
        "enabled": true,
        "enable_profit_close": false,
        "enable_loss_guard": false,
        "require_full_count_for_profit_close": false,
        "require_all_seen_green_once": false,
        "all_seen_green_pips": 0.0,
        "min_green_pnl_pips": 0.0,
        "rt_fast_window_ms": 0,
        "rt_poll_interval_ms": 150,
        "loss_guard_arming_ms": 0,
        "min_age_ms_for_any_close": 0
      },
      "footprint": {
        "enabled": true,
        "m1_min_ticks": 3,
        "m1_min_coverage_s": 1,
        "tickrate_min": 0.1,
        "veto_absorption": false,
        "warn_absorption": true,
        "absorption_penalty": 0.10
      },
      "orderflow": {
        "enabled": true,
        "delta_abs_min": 5.0
      },
      "triggers": {
        "enabled": true,
        "require_trigger": false,
        "min_strength": 0.0,
        "allow_opposite_trigger": true
      },
      "fusion": {
        "enabled": true,
        "enabled_assets": [
          "XAUUSD"
        ],
        "ttl_ms": 2500,
        "max_slippage_points": 150,
        "allow_degraded_vote": true,
        "require_phase_alignment": false,
        "require_footprint": false,
        "min_score_to_fire": 0.15,
        "of_score_scale": "0_1",
        "degraded_vote_conditions": {
          "min_of_delta_abs": 5.0,
          "min_of_score": 0.10
        }
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp",
    "use_trailing_stop": true
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional",
      "range_distribution",
      "range_retail"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "risk_per_trade_percent": 0.30,
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 150
  },
  "execution": {
    "position_sizing": {
      "mode": "risk_based",
      "fixed_lot": 0.01,
      "bump_to_min_lot": true,
      "min_order_volume": 0.01,
      "forbid_zero_volume": true
    }
  },
  "trade_executor_settings": {
    "version": "3.0",
    "fat_finger_check": {
      "enabled": true,
      "policy": "FLOOR",
      "max_absolute_volume_for_asset": {
        "XAUUSD": 1.5
      }
    },
    "halt_on_major_news": false
  },
  "guardrails": {
    "sessions": {
      "news_blackout": false
    },
    "vol": {
      "min_atr_m1": 0.0
    },
    "spread": {
      "max": 999.0
    }
  },
  "fusion": {
    "adaptive_weights": true,
    "seuils_entree": {
      "min_confidence": 0.05,
      "min_orderflow_score": 0.05,
      "max_spread_pts": 60
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "direct": 0.15,
      "conditional": 0.05
    },
    "momentum": {
      "breakout": {
        "lookback_bars": 30,
        "atr_period": 14,
        "max_width_over_atr": 1.6,
        "breakout_buffer_frac": 0.12
      },
      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.30
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 2.0,
        "close_edge_frac": 0.25
      }
    },
    "patterns": {
      "inside_bar": {
        "breakout_buffer_pips": 1.2
      }
    },
    "ponderations": {
      "trigger_weight": 0.40,
      "orderflow_weight": 0.40,
      "footprint_weight": 0.20,
      "coherence_bonus_max": 0.10
    }
  },
  "regles_metier": {
    "veto_absorption": false,
    "never_against_strong_orderflow": false,
    "triple_confirmation_bonus": true,
    "weak_footprint_score_th": 0.05
  },
  "base_trail_steps": 20,
  "smart_sl_tp_settings": {
    "DEPRECATION_NOTE": "Legacy fallback – kept for compatibility; dynamic block is authoritative.",
    "sl_placement_method": "ATR",
    "sl_atr_period": 14,
    "sl_atr_multiplier": 2.2,
    "sl_buffer_pips": 6,
    "tp_placement_method": "PIPS",
    "tp_rr_ratio": 1.6,
    "tp_atr_period": 14,
    "tp_atr_multiplier": 2.0,
    "sl_swing_lookback_period": 10,
    "stop_loss_pips": 250,
    "take_profit_pips": 10000
  },
  "smart_targets": {
    "risk_management": {
      "default_equity": 10000
    },
    "stop_loss": {
      "hard_min_points": 0,
      "hard_max_points": 100000
    },
    "take_profit": {
      "hard_max_points": 200000
    },
    "activation_loss": {
      "mode": "PIPS",
      "min_pips": 25.0
    },
    "step_loss": {
      "mode": "PIPS",
      "min_pips": 12.0,
      "update_interval_sec": 2.0
    }
  }
}