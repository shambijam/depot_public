{
  "strategy_name": "scalping",
  "version": "2.5-katana-micro-nogate",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "USDJPY",
    "USDCHF"
  ],
  "magic_number": 51001,
  "risk_per_trade_percent": 5.0,
  "stop_loss_pips": 6,
  "take_profit_pips": 10,
  "phase_detection": {
    "lookback_window": 60,
    "volatility_threshold": 0.006,
    "volume_zscore": 0.001,
    "eq_level_tolerance": 0,
    "impulse_threshold": 0,
    "use_phase_observer": true,
    "overrides": {
      "require_range_detection": false,
      "min_lookback_bars": 300,
      "use_bollinger_microphase": true
    },
    "bollinger_overrides": {
      "min_revert_score": 0.55,
      "min_breakout_score": 0.55,
      "use_squeeze_filter": true,
      "use_expansion_filter": true
    }
  },
  "decision_rules": [
    {
      "name": "baseline_scalping",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_detected",
          "ob_detected"
        ],
        "phase_must_contain": [
          "trend"
        ],
        "min_confidence": 0.3
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if bullish confluence and spread <= max_spread_points",
        "SELL": "enter if bearish confluence and spread <= max_spread_points"
      }
    },
    {
      "name": "range_scalping_microbreak",
      "priority": 2,
      "conditions": {
        "signal_must_contain": [
          "ob_detected"
        ],
        "phase_must_contain": [
          "range",
          "range_retail",
          "range_low_volatility"
        ],
        "min_confidence": 0.3
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish micro-break with OB confluence and spread <= max_spread_points",
        "SELL": "enter on bearish micro-break with OB confluence and spread <= max_spread_points"
      }
    },
    {
      "name": "range_midline_scalping",
      "priority": 3,
      "conditions": {
        "phase_must_contain": [
          "range",
          "range_low_volatility",
          "range_retail"
        ],
        "min_confidence": 0.3,
        "requires": {
          "is_range": true,
          "mid_entry": [
            "buy",
            "sell"
          ],
          "mid_entry_score_min": 0.55,
          "range_score_min": 0.62
        }
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if mid_entry == 'buy' and spread <= max_spread_points",
        "SELL": "enter if mid_entry == 'sell' and spread <= max_spread_points"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "boll_midline": {
        "strict_mode": false,
        "min_rr": 1.1,
        "tp_halfband_k": 1.0,
        "buffer_pips_min": 0.8,
        "min_mid_distance_ratio": 0.06,
        "require_range_regime": false,
        "block_on_expansion": false,
        "min_confidence": 0.3,
        "katana_min_confidence": 0.3,
        "fvg_max_distance_pips": 2.0,
        "ob_max_distance_pips": 2.0,
        "katana_soft_distance_mult": 1.25,
        "min_atr_m1_pips": 0.2,
        "max_spread_pips": 3.0,
        "ultra_near_pips": 0.6,
        "max_stop_pips_scalp": 15.0,
        "reject_if_sl_over_cap": false,
        "m1_break_bonus": 0.12,
        "only_trade_at_range_edges": false,
        "allow_midline_entries": true,
        "mid_entry_score_min": 0.55,
        "range_score_min": 0.62,
        "range_debounce_bars": 3
      },
      "liquidity_sweep": {
        "independent": true,
        "ignore_bollinger": true,
        "max_spread_pips": 5.0,
        "min_atr_m1_pips": 0.04,
        "lookback_bars": 30,
        "sweep": {
          "use_swings": true,
          "swing_window": 5,
          "reference": "recent_high_low",
          "wick_to_body_min_ratio": 1.8,
          "wick_size_min_pips": 2.0,
          "close_back_inside_range": true,
          "volume_spike_sigma": 1.0,
          "allow_gap_sweep": false
        },
        "absorption": {
          "confirm_candle_required": true,
          "confirm_timeframe": "M1",
          "confirm_max_latency_bars": 2,
          "body_to_range_min": 0.45,
          "closes_through_mid_of_sweep": true
        },
        "entry_logic": {
          "direction": "opposite_of_sweep",
          "trigger": "break_of_absorption_extreme",
          "buffer_pips": 0.4,
          "timeout_bars": 3
        },
        "risk_filters": {
          "mtf_bias_timeframe": "M5",
          "align_with_mtf_bias": true,
          "max_consecutive_signals": 2,
          "min_distance_to_round_number_pips": 1.5
        }
      }
    }
  },
  "execution_quality_filters": {
    "atr_volatility_filter": {
      "enabled": false,
      "period": 14,
      "min_atr": 0.0,
      "max_atr": 1000000000.0
    }
  },
  "execution_policy": {
    "max_spread_points": null
  },
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.0004,
      "max_spread_points": 60,
      "per_symbol_overrides": {
        "USDJPY": {
          "min_volatility": 0.0007,
          "max_spread_points": 120,
          "max_lot_size": 0.08
        },
        "EURUSD": {
          "max_lot_size": 0.15,
          "min_volatility": 0.0004,
          "max_spread_points": 60
        },
        "GBPUSD": {
          "max_lot_size": 0.15,
          "min_volatility": 0.00045,
          "max_spread_points": 60
        },
        "USDCHF": {
          "max_lot_size": 0.15,
          "min_volatility": 0.00035,
          "max_spread_points": 60
        }
      }
    },
    "mtf": {
      "timeframes": [
        "M1",
        "M5",
        "M15"
      ],
      "required_agreements": 1,
      "forbid_against_m15": false
    },
    "scoring": {
      "base_score": 0.8,
      "strategy_bias": 0.3,
      "liquidity_bonus": 0.1,
      "mtf_bonus_per_hit": 0.1,
      "best_opportunity_bonus": 0.15,
      "global_low_vol_penalty": -0.2,
      "high_spread_penalty": -0.1,
      "ob_conf_bonus": 0.25,
      "mtf_shortfall_penalty": -0.08
    },
    "filters": {
      "avoid_major_news": false,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true
    },
    "risk": {
      "max_trades_per_day": 20,
      "cooldown_seconds_after_trade": 0,
      "skip_asset_if_spread_over_points": 200,
      "max_lot_size": 0.15
    },
    "execution": {
      "order_type": "MARKET",
      "slippage_points": 5,
      "max_parallel_positions": 2,
      "entry_on_close_only": false,
      "confirm_spread_at_entry": false,
      "cooldown_bars_after_miss": 1
    },
    "katana": {
      "use_order_blocks": true,
      "ob_entry_override_enabled": true,
      "ob_entry_requires": {
        "spread_ok": true,
        "mtf_alignment_min": 0,
        "rr_min": 1.0
      },
      "bollinger_overrides": {
        "enabled": true,
        "min_bars": 200,
        "period": 20,
        "std_mult": 2.0,
        "squeeze_window": 100,
        "squeeze_percentile": 0.15,
        "atr_period": 14,
        "mode": "katana",
        "per_symbol": {
          "EURUSD": {
            "period": 18,
            "std_mult": 2.1,
            "squeeze_window": 120,
            "squeeze_percentile": 0.12
          },
          "GBPUSD": {
            "period": 20,
            "std_mult": 2.2
          },
          "USDJPY": {
            "period": 20,
            "std_mult": 2.0
          },
          "USDCHF": {
            "period": 22,
            "std_mult": 2.0
          }
        },
        "entry_bias": {
          "breakout_buy_min": 0.5,
          "breakout_sell_min": 0.5,
          "revert_buy_min": 0.5,
          "revert_sell_min": 0.5
        },
        "tp_sl_overrides": {
          "on_buy_breakout": {
            "tp_pips": 12,
            "sl_pips": 6
          },
          "on_sell_breakout": {
            "tp_pips": 12,
            "sl_pips": 6
          },
          "on_buy_revert": {
            "tp_pips": 10,
            "sl_pips": 6
          },
          "on_sell_revert": {
            "tp_pips": 10,
            "sl_pips": 6
          }
        },
        "range_scoring": {
          "enabled": true,
          "weights": {
            "bandwidth": 0.35,
            "adx": 0.25,
            "ema_slope": 0.2,
            "rsi_width": 0.2
          },
          "threshold_in": 0.62,
          "threshold_out": 0.52,
          "debounce_bars": 3,
          "rsi_period": 14,
          "ema_slope_window": 10,
          "adx_period": 14,
          "rsi_width_window": 14
        },
        "midline_entry": {
          "enabled": true,
          "pos_band_min": 0.1,
          "pos_band_max": 0.65,
          "mom_norm_min": 0.05,
          "base_threshold": 0.55,
          "min_range_duration_bars": 4,
          "sl_tp_profile": "midline",
          "use_rr_override": true,
          "rr_target": 1.1,
          "sl_pips_override": 5,
          "tp_pips_override": 7,
          "per_symbol": {
            "EURUSD": {
              "pos_band_min": 0.1,
              "pos_band_max": 0.6
            },
            "GBPUSD": {
              "pos_band_min": 0.12,
              "pos_band_max": 0.62
            },
            "USDJPY": {
              "pos_band_min": 0.1,
              "pos_band_max": 0.65
            },
            "USDCHF": {
              "pos_band_min": 0.1,
              "pos_band_max": 0.65
            }
          }
        }
      }
    }
  },
  "smart_targets": {
