{
  "strategy_name": "scalping",
  "version": "2.3",
  "description": "Scalping Burst propre (XAUUSD only)",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "risk_per_trade_percent": 3.0,
  "confidence_threshold": 0.30,
  "take_profit_pips": 80,
  "stop_loss_pips": 60,
  "max_spread_points": 50,
  "halt_on_major_news": false,
  "phase_detection": {
    "use_phase_observer": true,
    "allowed_phases": [
      "liquidity_eqh_eql",
      "range_retail",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "entry_rules": {
    "scalping": {
      "marubozu_playbook": {
        "enabled": true,
        "mtf_bias": {
          "use": true,
          "prefer_h1": true,
          "block_against_both": true
        },
        "detection": {
          "atr_period": 14,
          "lookback_bars": 3,
          "min_atr_mult": 2.2,
          "min_body_ratio": 0.85
        },
        "continuation": {
          "enabled": true,
          "pullback_frac_min": 0.2,
          "pullback_frac_max": 0.4,
          "rr_target": 1.5,
          "use_trailing": false,
          "trailing": {
            "trigger_pips": 12,
            "step_pips": 6
          }
        },
        "reversal": {
          "enabled": true,
          "rr_target": 1.2,
          "use_trailing": true,
          "trailing": {
            "trigger_pips": 10,
            "step_pips": 5
          }
        },
        "range_active": {
          "enabled": true,
          "lookback_bars": 20,
          "max_range_over_atr": 3.0,
          "min_avg_candle_atr": 0.9,
          "tolerance_frac": 0.15,
          "sl_pips": 30,
          "tp_mode": "mid_or_opposite",
          "use_trailing": true,
          "trailing": {
            "trigger_pips": 15,
            "step_pips": 7
          }
        }
      },
      "range_accumulation": {
        "enabled": true,
        "lookback_bars": 20,
        "tolerance_frac": 0.15,
        "sl_pips": 30,
        "tp_pips": 30
      },
      "range_accumulation_mtf": {
        "enabled": true,
        "bias_timeframes": [
          "M15",
          "H1"
        ],
        "lookback_bars": 20,
        "sl_pips": 25,
        "tp_pips": 40
      },
      "burst_scalping": {
        "enabled": true,
        "sl_pips": 5,
        "burst_size": 3,
        "max_spread_pips": 30.0,
        "min_atr_m1_pips": 0.0,
        "trailing": {
          "enabled": true,
          "trigger_pips": 15,
          "step_pips": 5,
          "activate_after_rr": 1.0
        },
        "closure_rules": {
          "momentum_score_min": 2,
          "breakout_lookback": 20,
          "atr_factor": 1.5,
          "enable_mtf_bias": true,
          "close_on_full_profit": true
        }
      }
    }
  },
  "exit_rules": {
    "use_trailing_stop": true,
    "trailing_stop": {
      "enabled": true,
      "distance_pips": 5.0
    }
  },
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.20
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ]
}