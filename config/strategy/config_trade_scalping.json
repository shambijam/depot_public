{
  "strategy_name": "scalping",
  "enabled": true,
  "risk_management": {
    "max_trades_per_day": 10,
    "max_trades_per_asset_per_day": 5,
    "min_rr": 1.5,
    "atr_penalty_factor": 0.85,
    "atr_confidence_floor": 0.35
  },
  "entry_rules": {
    "scalping": {
      "marubozu_playbook": {
        "enabled": true,
        "mtf_bias": {
          "use": true,
          "prefer_h1": true,
          "block_against_both": true
        },
        "detection": {
          "atr_period": 14,
          "lookback_bars": 3,
          "min_atr_mult": 2.2,
          "min_body_ratio": 0.85
        },
        "continuation": {
          "enabled": true,
          "pullback_frac_min": 0.2,
          "pullback_frac_max": 0.4,
          "rr_target": 1.5,
          "use_trailing": false,
          "trailing": {
            "trigger_pips": 12,
            "step_pips": 6
          }
        },
        "reversal": {
          "enabled": true,
          "rr_target": 1.2,
          "use_trailing": true,
          "trailing": {
            "trigger_pips": 10,
            "step_pips": 5
          }
        },
        "range_active": {
          "enabled": true,
          "lookback_bars": 20,
          "max_range_over_atr": 3.0,
          "min_avg_candle_atr": 0.9,
          "tolerance_frac": 0.15,
          "sl_pips": 30,
          "tp_mode": "mid_or_opposite",
          "use_trailing": true,
          "trailing": {
            "trigger_pips": 15,
            "step_pips": 7
          }
        }
      },
      "range_accumulation": {
        "enabled": true,
        "lookback_bars": 20,
        "tolerance_frac": 0.15,
        "sl_pips": 30,
        "tp_pips": 30
      },
      "range_accumulation_mtf": {
        "enabled": true,
        "bias_timeframes": [
          "M15",
          "H1"
        ],
        "lookback_bars": 20,
        "sl_pips": 25,
        "tp_pips": 40
      },
      "burst_scalping": {
        "enabled": true,
        "sl_pips": 5,
        "burst_size": 3,
        "max_spread_pips": 3.0,
        "min_atr_m1_pips": 2.5,
        "tp_sl": {
          "trailing": {
            "enabled": true,
            "trigger_pips": 15,
            "step_pips": 5,
            "activate_after_rr": 1.0
          }
        }
      }
    }
  },
  "exit_rules": {
    "use_trailing_stop": true,
    "trailing_stop": {
      "enabled": true,
      "distance_pips": 5.0
    }
  }
}