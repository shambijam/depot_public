    "trailing": {
      "enabled": false,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 1.2
    },
    "profiles": {
      "midline": {
        "description": "SL/TP serrés pour entrées médiane en range",
        "sl_type": "pips",
        "sl_pips": 5,
        "tp_type": "rr",
        "tp_rr_ratio": 1.1,
        "tp_pips_fallback": 7,
        "respect_broker_min_distance": true
      }
    }
  },
  "exit_rules": {
