{
  "strategy_name": "scalping",
  "description": "Scalping Burst — WIDE-EXTREME: SL très éloignés (ATR×5 + buffer), TP dynamique désactivé, trailing tardif anti-cisaille.",
  "version": "4.2-wide-extreme",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.80
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 5,
        "enforce_single_basket": true,
        "per_leg_virtual": false,
        "sltp": {
          "sl_method": "ATR",
          "rr_base": 2.2,
          "rr_floor": 1.2,
          "rr_cap": 5.0,
          "sl": {
            "atr_period": 14,
            "atr_multiplier": 5.0,
            "buffer_pips": 20,
            "swing_lookback": 30,
            "pips": 200
          },
          "tp": {
            "tp_method": "NONE",
            "atr_period": 14,
            "atr_multiplier": 4.0,
            "pips": 400,
            "execution": {
              "min_sl_tp_distance_pips": 120
            }
          }
        }
      },
      "trailing": {
        "enabled": true,
        "activation": {
          "mode": "ATR",
          "atr_period": 14,
          "atr_multiple": 4.0,
          "min_pips": 25.0
        },
        "step": {
          "mode": "ATR",
          "atr_multiple": 0.85,
          "min_pips": 10.0,
          "update_interval_ms": 4000
        },
        "break_even": {
          "enabled": true,
          "trigger": {
            "mode": "ATR",
            "atr_multiple": 2.2,
            "min_pips": 18.0
          },
          "offset_pips": 12.0
        },
        "broker_floors": {
          "min_sl_distance_pips": 8.0,
          "spread_multiplier": 4.0,
          "extra_buffer_pips": 4.0
        }
      },
      "closure_rules": {
        "enabled": false,
        "enable_profit_close": false,
        "enable_loss_guard": false,
        "require_full_count_for_profit_close": true,
        "require_all_seen_green_once": true,
        "all_seen_green_pips": 3.0,
        "min_green_pnl_pips": 1.0,
        "rt_fast_window_ms": 0,
        "rt_poll_interval_ms": 120,
        "max_loss_pips": 15.0,
        "loss_guard_arming_ms": 3000,
        "min_age_ms_for_any_close": 5000
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp",
    "use_trailing_stop": true
  },
  "phase_detection": {
    "use_phase_observer": true,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "risk_per_trade_percent": 0.30,
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 120
  },
  "trade_executor_settings": {
    "version": "3.0",
    "fat_finger_check": {
      "enabled": true,
      "policy": "FLOOR",
      "max_absolute_volume_for_asset": {
        "XAUUSD": 1.5
      }
    },
    "halt_on_major_news": false
  },
  "fusion": {
    "adaptive_weights": true,
    "seuils_entree": {
      "min_confidence": 0.80,
      "min_orderflow_score": 0.70,
      "max_spread_pts": 8
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "direct": 0.70,
      "conditional": 0.50
    },
    "momentum": {
      "breakout": {
        "lookback_bars": 30,
        "atr_period": 14,
        "max_width_over_atr": 1.6,
        "breakout_buffer_frac": 0.12
      },
      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.30
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 2.0,
        "close_edge_frac": 0.25
      }
    },
    "patterns": {
      "inside_bar": {
        "breakout_buffer_pips": 1.2
      }
    },
    "ponderations": {
      "trigger_weight": 0.40,
      "orderflow_weight": 0.40,
      "footprint_weight": 0.20,
      "coherence_bonus_max": 0.10
    }
  },
  "regles_metier": {
    "veto_absorption": true,
    "never_against_strong_orderflow": true,
    "triple_confirmation_bonus": true,
    "weak_footprint_score_th": 0.65
  },
  "base_trail_steps": 20,
  "smart_sl_tp_settings": {
    "DEPRECATION_NOTE": "Legacy fallback – kept for compatibility until code reads only the dynamic block.",
    "sl_placement_method": "ATR",
    "sl_atr_period": 14,
    "sl_atr_multiplier": 2.2,
    "sl_buffer_pips": 6,
    "tp_placement_method": "PIPS",
    "tp_rr_ratio": 1.6,
    "tp_atr_period": 14,
    "tp_atr_multiplier": 2.0,
    "sl_swing_lookback_period": 10,
    "stop_loss_pips": 200,
    "take_profit_pips": 10000
  },
  "smart_targets": {
    "risk_management": {
      "default_equity": 10000
    },
    "stop_loss": {
      "hard_min_points": 0,
      "hard_max_points": 100000
    },
    "take_profit": {
      "hard_max_points": 200000
    }
  }
}