{
  "strategy_name": "scalping",
  "version": "2.6-katana-micro-openvalves",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "USDJPY",
    "USDCHF"
  ],
  "magic_number": 51001,
  "risk_per_trade_percent": 5.0,
  "stop_loss_pips": 6,
  "take_profit_pips": 10,
  "phase_detection": {
    "lookback_window": 60,
    "volatility_threshold": 0.006,
    "volume_zscore": 0.001,
    "eq_level_tolerance": 0,
    "impulse_threshold": 0,
    "use_phase_observer": true,
    "overrides": {
      "require_range_detection": false,
      "min_lookback_bars": 300,
      "use_bollinger_microphase": true
    },
    "bollinger_overrides": {
      "min_revert_score": 0.48,
      "min_breakout_score": 0.48,
      "use_squeeze_filter": true,
      "use_expansion_filter": true
    }
  },
  "decision_rules": [
    {
      "name": "baseline_scalping",
      "priority": 1,
      "conditions": {
        "signal_must_contain_any": [
          "fvg_detected",
          "ob_detected",
          "momentum_burst",
          "micro_pullback"
        ],
        "phase_must_contain_any": [
          "trend",
          "trending_retail_bull",
          "trending_retail_bear"
        ],
        "min_confidence": 0.25
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if bullish confluence and spread <= max_spread_points",
        "SELL": "enter if bearish confluence and spread <= max_spread_points"
      }
    },
    {
      "name": "range_scalping_microbreak",
      "priority": 2,
      "conditions": {
        "signal_must_contain_any": [
          "ob_detected",
          "liquidity_sweep_detected",
          "micro_breakout"
        ],
        "phase_must_contain_any": [
          "range",
          "range_retail",
          "range_low_volatility"
        ],
        "min_confidence": 0.25
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish micro-break with OB/liquidity confluence and spread <= max_spread_points",
        "SELL": "enter on bearish micro-break with OB/liquidity confluence and spread <= max_spread_points"
      }
    },
    {
      "name": "range_midline_scalping",
      "priority": 3,
      "conditions": {
        "phase_must_contain_any": [
          "range",
          "range_low_volatility",
          "range_retail"
        ],
        "min_confidence": 0.28,
        "requires": {
          "is_range": true,
          "mid_entry": [
            "buy",
            "sell"
          ],
          "mid_entry_score_min": 0.50,
          "range_score_min": 0.58
        }
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if mid_entry == 'buy' and spread <= max_spread_points",
        "SELL": "enter if mid_entry == 'sell' and spread <= max_spread_points"
      }
    },
    {
      "name": "momentum_trail_scalp",
      "priority": 4,
      "conditions": {
        "signal_must_contain_any": [
          "momentum_burst",
          "m1_two_bull_candles",
          "m1_two_bear_candles"
        ],
        "min_confidence": 0.22
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on 2+ bullish M1 candles with positive M5 bias; immediately arm trailing",
        "SELL": "enter on 2+ bearish M1 candles with negative M5 bias; immediately arm trailing"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "boll_midline": {
        "strict_mode": false,
        "min_rr": 1.05,
        "tp_halfband_k": 1.0,
        "buffer_pips_min": 0.3,
        "min_mid_distance_ratio": 0.03,
        "require_range_regime": false,
        "block_on_expansion": false,
        "min_confidence": 0.28,
        "katana_min_confidence": 0.28,
        "fvg_max_distance_pips": 3.0,
        "ob_max_distance_pips": 3.0,
        "katana_soft_distance_mult": 1.35,
        "min_atr_m1_pips": 0.05,
        "max_spread_pips": 4.0,
        "ultra_near_pips": 0.5,
        "max_stop_pips_scalp": 15.0,
        "reject_if_sl_over_cap": false,
        "m1_break_bonus": 0.15,
        "only_trade_at_range_edges": false,
        "allow_midline_entries": true,
        "allow_breakout_entries": true,
        "mid_entry_score_min": 0.50,
        "range_score_min": 0.58,
        "range_debounce_bars": 2
      },
      "momentum": {
        "enabled": true,
        "m1_min_consecutive_candles": 2,
        "m1_body_to_range_min": 0.55,
        "m5_bias_filter": true,
        "pullback_max_bars": 2,
        "max_spread_pips": 4.0,
        "min_atr_m1_pips": 0.05
      }
    }
  },
  "execution_quality_filters": {
    "atr_volatility_filter": {
