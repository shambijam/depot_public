{
  "strategy_name": "scalping",
  "description": "Scalping Burst institutionnel — SL/TP 300 pips fixes. Pas de veto, pas de gates bloquants.",
  "version": "4.4-unblocked",
  "tradeable_assets": [
    "XAUUSD",
    "EURUSD",
    "GBPUSD"
  ],
  "magic_number": 52001,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.40
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 8,
        "enforce_single_basket": true,
        "per_leg_virtual": false,
        "sltp": {
          "exit_mode": "sl_tp_then_trail",
          "sl_method": "PIPS",
          "rr_base": 1.5,
          "rr_floor": 1.0,
          "rr_cap": 3.0,
          "sl": {
            "pips": 300,
            "buffer_pips": 2,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "swing_lookback": 0
          },
          "tp": {
            "tp_method": "PIPS",
            "pips": 300,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "execution": {
              "min_sl_tp_distance_pips": 10
            }
          }
        },
        "closure_rules": {
          "enabled": true,
          "enable_profit_close": true,
          "target_profit_pips": 30.0,
          "require_full_count_for_profit_close": true,
          "rt_fast_window_ms": 120000,
          "rt_poll_interval_ms": 100,
          "min_age_ms_for_any_close": 2000,
          "enable_loss_guard": true,
          "max_loss_pips": 148.0,
          "loss_guard_arming_ms": 3000
        }
      },
      "footprint": {
        "enabled": true,
        "m1_min_ticks": 50,
        "m1_min_coverage_s": 15,
        "tickrate_min": 2.0,
        "veto_absorption": true,
        "warn_absorption": false,
        "absorption_penalty": 0.25
      },
      "orderflow": {
        "enabled": true,
        "delta_abs_min": 30.0
      },
      "vwap": {
        "enabled": true,
        "session_reset": "midnight_utc",
        "calculation_method": "standard",
        "min_ticks_required": 20
      },
      "fusion": {
        "enabled": true,
        "enabled_assets": [
          "XAUUSD"
        ],
        "ttl_ms": 800,
        "max_slippage_points": 100,
        "require_phase_alignment": false,
        "require_footprint": true,
        "of_score_scale": "0_1",
        "ponderations": {
          "trigger_weight": 0.0,
          "orderflow_weight": 0.30,
          "footprint_weight": 0.35,
          "vwap_weight": 0.35
        }
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp"
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 150
  },
  "guardrails": {
    "enabled": false,
    "sessions": {
      "news_blackout": false
    },
    "vol": {
      "min_atr_m1": 0.0
    },
    "spread": {
      "max": 999.0
    }
  },
  "fusion": {
    "adaptive_weights": true,
    "allow_conditional_entries": true,
    "seuils_entree": {
      "min_confidence": 0.40,
      "min_orderflow_score": 0.40,
      "max_spread_pts": 30
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "high": 0.60,
      "moderate": 0.55,
      "cautious": 0.40,
      "conditional": 0.70
    },
    "momentum": {
      "enabled": false,
      "breakout": {
        "lookback_bars": 30,
        "atr_period": 14,
        "max_width_over_atr": 1.6,
        "breakout_buffer_frac": 0.12
      },
      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.30
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 2.0,
        "close_edge_frac": 0.25
      }
    },
    "patterns": {
      "enabled": false,
      "inside_bar": {
        "breakout_buffer_pips": 1.2
      }
    },
    "range_accumulation": {
      "enabled": false
    },
    "range_accumulation_mtf": {
      "enabled": false
    },
    "ponderations": {
      "trigger_weight": 0.0,
      "orderflow_weight": 0.35,
      "footprint_weight": 0.30,
      "vwap_weight": 0.35,
      "coherence_bonus_max": 0.10
    }
  },
  "regles_metier": {
    "veto_absorption": true,
    "never_against_strong_orderflow": true,
    "triple_confirmation_bonus": true,
    "weak_footprint_score_th": 0.60
  },
  "logging": {
    "footprint_mode": "verbose"
  },
  "legacy": {
    "smart_sl_tp_settings": {
      "disabled": true,
      "note": "DEPRECATED – ignoré"
    },
    "smart_targets": {
      "disabled": true,
      "note": "DEPRECATED – ignoré"
    }
  }
}