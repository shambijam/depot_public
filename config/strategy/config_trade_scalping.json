{
  "strategy_name": "scalping",
  "description": "Scalping Burst institutionnel — SL/TP 300 pips fixes. Pas de veto, pas de gates bloquants.",
  "version": "4.4-unblocked",
  "tradeable_assets": [
    "USDJPY"
  ],
  "magic_number": 52001,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.75
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 11,
        "enforce_single_basket": true,
        "per_leg_virtual": false,
        "sltp": {
          "exit_mode": "sl_tp_then_trail",
          "sl_method": "PIPS",
          "rr_base": 1.5,
          "rr_floor": 1.0,
          "rr_cap": 3.0,
          "sl": {
            "pips": 15,
            "buffer_pips": 2,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "swing_lookback": 0
          },
          "tp": {
            "tp_method": "PIPS",
            "pips": 20,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "execution": {
              "min_sl_tp_distance_pips": 10
            }
          }
        },
        "closure_rules": {
          "enabled": true,
          "enable_profit_close": true,
          "target_profit_pips": 11.0,
          "require_full_count_for_profit_close": true,
          "rt_fast_window_ms": 120000,
          "rt_poll_interval_ms": 100,
          "min_age_ms_for_any_close": 2000,
          "enable_loss_guard": true,
          "max_loss_pips": 80.0,
          "loss_guard_arming_ms": 3000
        }
      },
      "footprint": {
        "enabled": true,
        "m1_min_ticks": 100,
        "m1_min_coverage_s": 30,
        "tickrate_min": 3.0,
        "veto_absorption": true,
        "warn_absorption": false,
        "absorption_penalty": 0.25
      },
      "orderflow": {
        "enabled": true,
        "delta_abs_min": 100.0
      },
      "vwap": {
        "enabled": true,
        "session_reset": "midnight_utc",
        "calculation_method": "standard",
        "min_ticks_required": 20
      },
      "fusion": {
        "enabled": true,
        "enabled_assets": [
          "USDJPY"
        ],
        "ttl_ms": 800,
        "max_slippage_points": 100,
        "require_phase_alignment": false,
        "require_footprint": true,
        "of_score_scale": "0_1"
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp"
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 150
  },
  "guardrails": {
    "enabled": false,
    "sessions": {
      "news_blackout": false
    },
    "vol": {
      "min_atr_m1": 0.0
    },
    "spread": {
      "max": 999.0
    }
  },
  "fusion": {
    "adaptive_weights": true,
    "allow_conditional_entries": true,
    "seuils_entree": {
      "min_confidence": 0.75,
      "min_orderflow_score": 0.50,
      "max_spread_pts": 30
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "high": 0.80,
      "moderate": 0.75,
      "cautious": 0.75,
      "conditional": 0.60
    },
    "momentum": {
      "enabled": false,
