{
  "strategy_name": "scalping",
  "version": "2.1-tight-safe",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "XAUUSD",
    "AUDUSD"
  ],
  "phase_detection": {
    "use_phase_observer": true,
    "lookback_window": 200,
    "volatility_threshold": 0.006,
    "volume_zscore": 0.001,
    "overrides": {
      "require_range_detection": true,
      "min_lookback_bars": 500
    }
  },
  "magic_number": 51001,
  "risk_per_trade_percent": 0.20,
  "stop_loss_pips": 30,
  "take_profit_pips": 60,
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.006,
      "max_spread_points": 50,
      "min_volume_score": 0.01,
      "per_symbol_overrides": {
        "NAS100": {
          "max_spread_points": 70,
          "max_lot_size": 0.04
        },
        "XAUUSD": {
          "min_volatility": 0.004,
          "max_spread_points": 45,
          "max_lot_size": 0.08
        },
        "EURUSD": {
          "max_lot_size": 0.15
        },
        "GBPUSD": {
          "max_lot_size": 0.15
        }
      }
    },
    "mtf": {
      "timeframes": [
        "M1",
        "M5",
        "M15"
      ],
      "required_agreements": 3
    },
    "scoring": {
      "base_score": 0.80,
      "strategy_bias": 0.30,
      "liquidity_bonus": 0.10,
      "mtf_bonus_per_hit": 0.10,
      "best_opportunity_bonus": 0.15,
      "global_low_vol_penalty": -0.20,
      "high_spread_penalty": -0.30,
      "ob_conf_bonus": 0.25
    },
    "filters": {
      "avoid_major_news": true,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true,
      "allow_momentum_fallback": false
    },
    "risk": {
      "max_trades_per_day": 3,
      "cooldown_seconds_after_trade": 1200,
      "skip_asset_if_spread_over_points": 50,
      "max_lot_size": 0.15
    },
    "execution": {
      "order_type": "market",
      "slippage_points": 3,
      "max_parallel_positions": 1,
      "entry_on_close_only": true,
      "confirm_spread_at_entry": true,
      "cooldown_bars_after_miss": 3
    },
    "katana": {
      "use_order_blocks": true,
      "ob_entry_override_enabled": true,
      "ob_entry_requires": {
        "spread_ok": true,
        "mtf_alignment_min": 2,
        "rr_min": 1.5
      }
    }
  },
  "decision_rules": [
    {
      "name": "baseline_scalping",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_detected",
          "ob_detected"
        ],
        "phase_must_contain": [
          "trend"
        ],
        "min_confidence": 0.80
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if bullish confluence and spread <= max_spread_points",
        "SELL": "enter if bearish confluence and spread <= max_spread_points"
      }
    }
  ],
  "smart_targets": {
    "take_profit": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 2.2,
      "fallback_rr": 1.6
    },
    "stop_loss": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.4,
      "hard_min_points": 30
    },
    "breakeven": {
      "enabled": true,
      "trigger_rr": 1.0,
      "lock_points": 2
    },
    "partial_take_profit": {
      "enabled": true,
      "at_rr": 1.0,
      "close_percent": 50
    },
    "trailing": {
      "enabled": false,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 2.0
    }
  },
  "exit_rules": {
    "time_based": {
      "enabled": true,
      "max_trade_minutes": 120
    },
    "invalidated_setup": {
      "enabled": true,
      "close_on_break_even_if_reenter": false
    },
    "news_exit": {
      "enabled": true,
      "minutes_before": 2,
      "minutes_after": 2
    }
  }
}
