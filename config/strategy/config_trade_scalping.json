{
  "strategy_name": "scalping",
  "version": "2.5-katana-micro-nogate",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 51001,
  "phase_detection": {
    "range_sensitivity": 0.55,
    "low_vol_window": 100,
    "low_vol_percentile": 0.15,
    "atr_period": 14,
    "min_bars": 200,
    "std_mult": 2.0,
    "squeeze_window": 100,
    "squeeze_percentile": 0.15,
    "lookback_window": 200,
    "volatility_threshold": 0.0001,
    "volume_zscore": 1.2
  },
  "decision_rules": [
    {
      "name": "range_scalping_microbreak",
      "priority": 2,
      "conditions": {
        "signal_must_contain": [
          "ob_detected"
        ],
        "phase_must_contain": [
          "range",
          "range_retail",
          "range_low_volatility"
        ],
        "min_confidence": 0.20
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish micro-break with OB confluence and spread <= max_spread_pips",
        "SELL": "enter on bearish micro-break with OB confluence and spread <= max_spread_pips"
      }
    },
    {
      "name": "range_midline_scalping",
      "priority": 3,
      "conditions": {
        "phase_must_contain": [
          "range",
          "range_low_volatility",
          "range_retail"
        ],
        "min_confidence": 0.3,
        "requires": {
          "is_range": true,
          "mid_entry": [
            "buy",
            "sell"
          ],
          "mid_entry_score_min": 0.55,
          "range_score_min": 0.62
        }
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if mid_entry == 'buy' and spread <= max_spread_pips",
        "SELL": "enter if mid_entry == 'sell' and spread <= max_spread_pips"
      }
    },
    {
      "name": "liquidity_sweep_absorption",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "liquidity_sweep",
          "absorption_confirmed"
        ],
        "min_confidence": 0.3
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "take opposite of bearish sweep after absorption confirmation",
        "SELL": "take opposite of bullish sweep after absorption confirmation"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "atr_filter": {
        "enabled": true,
        "min_atr_pips": 4.0
      },
      "absorption": {
        "confirm_candle_required": true,
        "confirm_timeframe": "M1",
        "confirm_max_latency_bars": 2,
        "body_to_range_min": 0.45,
        "closes_through_mid_of_sweep": true
      },
      "entry_logic": {
        "direction": "opposite_of_sweep",
        "trigger": "break_of_absorption_extreme",
        "buffer_pips": 0.4,
        "timeout_bars": 3
      },
      "risk_filters": {
        "mtf_bias_timeframe": "M5",
        "align_with_mtf_bias": true,
        "max_consecutive_signals": 2,
        "min_distance_to_round_number_pips": 1.5
      }
    }
  },
  "execution_quality_filters": {
    "atr_volatility_filter": {
      "enabled": true,
      "period": 14,
      "min_atr": 0.0,
      "max_atr": 1000000000.0
    }
  },
  "risk_limits": {
    "max_spread_pips": 6,
    "per_symbol": {
      "USDJPY": {
        "max_spread_pips": 12
      },
      "EURUSD": {
        "max_spread_pips": 6
      },
      "GBPUSD": {
        "max_spread_pips": 6
