      "stop_loss_pips_low_vol": 6,
      "take_profit_pips_low_vol": 9
    },
    "risk_adjustment": {
      "risk_reduction_multiplier_high_vol": 0.5,
      "min_risk_percent_after_adjustment": 0.05
    },
    "ema_rsi_atr_trail": {
      "enabled": true,
      "risk_per_trade_pct": 0.6,
      "ema_short_period": 5,
      "ema_long_period": 20,
      "rsi_period": 14,
      "rsi_overbought": 70,
      "rsi_oversold": 30,
      "atr_period": 14,
      "atr_multiplier_initial": 1.5,
      "atr_multiplier_trailing": 1.0,
      "volatility_filter_threshold": 0.01
    },
    "use_ema_rsi_atr_trail": true
  },
  "rules": {
    "liquidity_sweep_breaker": {
      "enabled": true,
      "description": "Stop-hunt / liquidity sweep + absorption confirmation, independent from Bollinger midline.",
      "independent_from_bollinger_midline": true,
      "requires_phase": [
        "no_clear_phase",
        "ranging",
        "trending_retail_bull",
        "trending_retail_bear",
        "low_volatility_compression"
      ],
      "allow_when": {
        "news_blackout_minutes_before": 2,
        "news_blackout_minutes_after": 2
      },
      "entry_ref": "liquidity_sweep",
      "tp_sl_profile": "liquidity_sweep_rr_trail",
      "force_trailing": false,
      "arm_immediately_on_liquidity_rule": true,
      "cooldown_seconds": 45
    },
    "priority": [
      "momentum_trail_scalp",
      "liquidity_sweep_breaker",
      "baseline_scalping",
      "range_scalping_microbreak",
      "range_midline_scalping"
    ]
  },
  "tp_sl_profiles": {
    "liquidity_sweep_rr_trail": {
