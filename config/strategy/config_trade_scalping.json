{
  "strategy_name": "scalping",
  "description": "Scalping Burst institutionnel — SL/TP 400 pips puis trailing à +28 pips. Pas de veto, pas de gates bloquants.",
  "version": "4.4-unblocked",
  "tradeable_assets": [
    "XAUUSD",
    "EURUSD",
    "GBPUSD"
  ],
  "magic_number": 52001,
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.05
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "entry_mode": "MARKET",
        "burst_size": 5,
        "enforce_single_basket": true,
        "per_leg_virtual": false,
        "sltp": {
          "exit_mode": "sl_tp_then_trail",
          "sl_method": "PIPS",
          "rr_base": 1.5,
          "rr_floor": 1.0,
          "rr_cap": 3.0,
          "sl": {
            "pips": 400,
            "buffer_pips": 2,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "swing_lookback": 0
          },
          "tp": {
            "tp_method": "PIPS",
            "pips": 400,
            "atr_period": 14,
            "atr_multiplier": 0.0,
            "execution": {
              "min_sl_tp_distance_pips": 10
            }
          }
        },
        "trailing": {
          "enabled": true,
          "activation": {
            "mode": "PIPS",
            "min_pips": 28.0
          },
          "step": {
            "mode": "PIPS",
            "min_pips": 8.0,
            "update_interval_sec": 2.0
          },
          "break_even": {
            "enabled": false
          },
          "broker_floors": {
            "min_sl_distance_pips": 6.0,
            "spread_multiplier": 0.0,
            "extra_buffer_pips": 0.0
          }
        }
      },
      "footprint": {
        "enabled": true,
        "m1_min_ticks": 3,
        "m1_min_coverage_s": 1,
        "tickrate_min": 0.1,
        "veto_absorption": false,
        "warn_absorption": false,
        "absorption_penalty": 0.0
      },
      "orderflow": {
        "enabled": true,
        "delta_abs_min": 5.0
      },
      "triggers": {
        "enabled": true,
        "require_trigger": false,
        "min_strength": 0.0,
        "allow_opposite_trigger": true
      },
      "fusion": {
        "enabled": true,
        "enabled_assets": [
          "XAUUSD",
          "EURUSD",
          "GBPUSD"
        ],
        "ttl_ms": 800,
        "max_slippage_points": 150,
        "allow_degraded_vote": true,
        "require_phase_alignment": false,
        "require_footprint": false,
        "min_score_to_fire": 0.15,
        "of_score_scale": "0_1",
        "degraded_vote_conditions": {
          "min_of_delta_abs": 0.0,
          "min_of_score": 0.0
        }
      }
    }
  },
  "exit_rules": {
    "managed_by": "sltp",
    "use_trailing_stop": true
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional",
      "range_distribution",
      "range_retail"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "risk": {
    "position_size": "risk_based",
    "risk_per_trade_percent": 0.30,
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 150
  },
  "guardrails": {
    "enabled": false,
    "sessions": {
      "news_blackout": false
    },
    "vol": {
      "min_atr_m1": 0.0
    },
    "spread": {
      "max": 999.0
    }
  },
  "fusion": {
    "adaptive_weights": true,
    "seuils_entree": {
      "min_confidence": 0.05,
      "min_orderflow_score": 0.00,
      "max_spread_pts": 999
    },
    "scoring_weights": {
      "context": 0.30,
      "technical": 0.40,
      "orderflow": 0.20,
      "risk": 0.10
    },
    "scoring_thresholds": {
      "direct": 0.15,
      "conditional": 0.05
    },
    "momentum": {
      "enabled": false,
      "breakout": {
        "lookback_bars": 30,
        "atr_period": 14,
        "max_width_over_atr": 1.6,
        "breakout_buffer_frac": 0.12
      },
      "trend_pullback": {
        "ma_short": 9,
        "ma_long": 21,
        "pullback_tolerance_frac": 0.30
      },
      "ignition": {
        "atr_period": 14,
        "min_atr_mult": 2.0,
        "close_edge_frac": 0.25
      }
    },
    "patterns": {
      "enabled": false,
      "inside_bar": {
        "breakout_buffer_pips": 1.2
      }
    },
    "range_accumulation": {
      "enabled": false
    },
    "range_accumulation_mtf": {
      "enabled": false
    },
    "ponderations": {
      "trigger_weight": 0.40,
      "orderflow_weight": 0.40,
      "footprint_weight": 0.20,
      "coherence_bonus_max": 0.10
    }
  },
  "regles_metier": {
    "veto_absorption": false,
    "never_against_strong_orderflow": false,
    "triple_confirmation_bonus": true,
    "weak_footprint_score_th": 0.00
  },
  "legacy": {
    "smart_sl_tp_settings": {
      "disabled": true,
      "note": "DEPRECATED – ignoré"
    },
    "smart_targets": {
      "disabled": true,
      "note": "DEPRECATED – ignoré"
    }
  }
}