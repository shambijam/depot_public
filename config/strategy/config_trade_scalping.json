{
  "strategy_name": "scalping",
  "version": "2.4",
  "description": "Scalping Burst — Single-Master (1 broker position, trailing-only, no TP)",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "risk_per_trade_percent": 3.0,
  "confidence_threshold": 0.2,
  "halt_on_major_news": false,
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "liquidity_eqh_eql",
      "range_retail",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "entry_rules": {
    "scalping": {
      "burst_scalping": {
        "enabled": true,
        "burst_size": 5,
        "max_bursts": 1
      }
    }
  },
  "burst_single_master": {
    "enabled": true,
    "burst_size": 5,
    "entry_mode": "MARKET",
    "per_leg_virtual": true,
    "min_hold_ms": 800,
    "enforce_single_position": true
  },
  "dynamic_trailing": {
    "enabled": true,
    "mode": "ATR",
    "atr_period": 14,
    "atr_mult": 0.6,
    "min_trail_points": 30,
    "arm_profit_points": 60,
    "arm_atr_multiple": 0.8,
    "max_pullback_points": 80,
    "trail_update_throttle_ms": 250,
    "backoff_step_points": 10,
    "breakeven_lock_points": 10,
    "max_spread_points_when_armed": 40,
    "max_latency_ms_on_close": 500
  },
  "exit_rules": {
    "managed_by": "single_master",
    "use_trailing_stop": false
  },
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.2
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "cooldown_after_exit_s": 20,
  "risk": {
    "max_positions_per_symbol": 1,
    "position_size": "risk_based",
    "stop_distance_pips": 60
  }
}