{
  "strategy_name": "scalping",
  "version": "2.5",
  "description": "Scalping Burst — Single-Master (1 broker position, trailing-only, no TP)",
  "tradeable_assets": [
    "XAUUSD"
  ],
  "magic_number": 52001,
  "confidence_threshold": 0.2,
  "halt_on_major_news": false,
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "liquidity_eqh_eql",
      "range_retail",
      "transitional"
    ],
    "lookback_window": 12,
    "volatility_threshold": 0.0,
    "volume_zscore": 0.0,
    "eq_level_tolerance": 0.0,
    "impulse_threshold": 0.0
  },
  "closure_rules": {
    "close_on_full_profit": false,
    "require_full_count_for_profit_close": false,
    "min_green_pnl_pips": 20,
    "rt_fast_window_ms": 3000,
    "rt_poll_interval_ms": 200,
    "max_loss_pips": 200,
    "trail_trigger_pips": 60,
    "trail_distance_pips": 60,
    "trail_require_full_count": false,
    "min_hold_ms": 4000,
    "loss_guard_cooldown_ms": 6000,
    "loss_guard_require_full_count": false,
    "min_positions_for_loss_guard": 1,
    "require_all_seen_green_once": true,
    "all_seen_green_pips": 5,
    "loss_guard_arming_ms": 5000
  },
  "entry_rules": {
    "scalping": {
      "burst_single_master": {
        "enabled": true,
        "burst_size": 5,
        "entry_mode": "MARKET",
        "per_leg_virtual": true,
        "min_hold_ms": 3000,
        "enforce_single_position": true
      }
    }
  },
  "dynamic_trailing": {
    "enabled": true,
    "mode": "ATR",
    "atr_period": 21,
    "atr_mult": 2.8,
    "min_trail_points": 150,
    "arm_profit_points": 140,
    "arm_atr_multiple": 2.5,
    "pre_arm_grace_ms": 6000,
    "arm_require_full_count": true,
    "max_pullback_points": 350,
    "trail_update_throttle_ms": 3000,
    "backoff_step_points": 70,
    "breakeven_lock_points": 200,
    "max_spread_points_when_armed": 100,
    "min_seconds_before_any_close": 18,
    "max_latency_ms_on_close": 600
  },
  "exit_rules": {
    "managed_by": "single_master",
    "use_trailing_stop": false
  },
  "decision_rules": [
    {
      "name": "scalping_entry",
      "priority": 1,
      "conditions": {
        "min_confidence": 0.2
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter_on_scalping_signal",
        "SELL": "enter_on_scalping_signal"
      }
    }
  ],
  "cooldown_after_exit_s": 12,
  "risk": {
    "position_size": "risk_based",
    "risk_per_trade_percent": 0.11,
    "max_positions_per_symbol": 1,
    "stop_distance_pips": 60
  },
  "risk_per_trade_percent": 0.11
}