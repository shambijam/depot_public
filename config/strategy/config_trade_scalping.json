{
  "strategy_name": "scalping",
  "version": "2.4-katana-micro-unleashed",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "USDJPY",
    "USDCHF"
  ],
  "entry_rules": {
    "scalping": {
      "gating_mode": "katana",
      "fvg_max_distance_pips": 2.0,
      "ob_max_distance_pips": 2.0,
      "min_atr_m1_pips": 0.3,
      "hard_min_atr_m1_pips": 0.12,
      "max_spread_pips": 3.0,
      "hard_max_spread_pips": 3.5,
      "ultra_near_pips": 0.6,
      "max_stop_pips_scalp": 8.0,
      "reject_if_sl_over_cap": false
    }
  },
  "execution_quality_filters": {
    "atr_volatility_filter": {
      "enabled": false,
      "period": 14,
      "min_atr": 0.0,
      "max_atr": 1000000000.0
    }
  },
  "execution_policy": {
    "max_spread_points": null
  },
  "phase_detection": {
    "use_phase_observer": true,
    "lookback_window": 60,
    "volatility_threshold": 0.006,
    "volume_zscore": 0.001,
    "overrides": {
      "require_range_detection": false,
      "min_lookback_bars": 300
    },
    "bollinger_overrides": {
      "min_revert_score": 0.55,
      "min_breakout_score": 0.55,
      "use_squeeze_filter": true,
      "use_expansion_filter": true
    }
  },
  "magic_number": 51001,
  "risk_per_trade_percent": 0.6,
  "stop_loss_pips": 8,
  "take_profit_pips": 14,
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.0004,
      "max_spread_points": 60,
      "per_symbol_overrides": {
        "USDJPY": {
          "min_volatility": 0.0007,
          "max_spread_points": 120,
          "max_lot_size": 0.08
        },
        "EURUSD": {
          "max_lot_size": 0.15,
          "min_volatility": 0.0004,
          "max_spread_points": 60
        },
        "GBPUSD": {
          "max_lot_size": 0.15,
          "min_volatility": 0.00045,
          "max_spread_points": 60
        },
        "USDCHF": {
          "max_lot_size": 0.15,
          "min_volatility": 0.00035,
          "max_spread_points": 60
        }
      }
    },
    "mtf": {
      "timeframes": [
        "M1",
        "M5",
        "M15"
      ],
      "required_agreements": 1,
      "forbid_against_m15": false
    },
    "scoring": {
      "base_score": 0.8,
      "strategy_bias": 0.3,
      "liquidity_bonus": 0.1,
      "mtf_bonus_per_hit": 0.1,
      "best_opportunity_bonus": 0.15,
      "global_low_vol_penalty": -0.2,
      "high_spread_penalty": -0.1,
      "ob_conf_bonus": 0.25
    },
    "filters": {
      "avoid_major_news": false,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true,
      "allow_momentum_fallback": false
    },
    "risk": {
      "max_trades_per_day": 20,
      "cooldown_seconds_after_trade": 0,
      "skip_asset_if_spread_over_points": 60,
      "max_lot_size": 0.15
    },
    "execution": {
      "order_type": "MARKET",
      "slippage_points": 5,
      "max_parallel_positions": 2,
      "entry_on_close_only": false,
      "confirm_spread_at_entry": false,
      "cooldown_bars_after_miss": 1
    },
    "katana": {
      "use_order_blocks": true,
      "ob_entry_override_enabled": true,
      "ob_entry_requires": {
        "spread_ok": true,
        "mtf_alignment_min": 1,
        "rr_min": 1.3
      },
      "bollinger_overrides": {
        "enabled": true,
        "min_bars": 200,
        "period": 20,
        "std_mult": 2.0,
        "squeeze_window": 100,
        "squeeze_percentile": 0.15,
        "atr_period": 14,
        "mode": "katana",
        "per_symbol": {
          "EURUSD": {
            "period": 18,
            "std_mult": 2.1,
            "squeeze_window": 120,
            "squeeze_percentile": 0.12
          },
          "GBPUSD": {
            "period": 20,
            "std_mult": 2.2
          },
          "USDJPY": {
            "period": 20,
            "std_mult": 2.0
          },
          "USDCHF": {
            "period": 22,
            "std_mult": 2.0
          }
        },
        "entry_bias": {
          "breakout_buy_min": 0.55,
          "breakout_sell_min": 0.55,
          "revert_buy_min": 0.55,
          "revert_sell_min": 0.55
        },
        "tp_sl_overrides": {
          "on_buy_breakout": {
            "tp_pips": 16,
            "sl_pips": 8
          },
          "on_sell_breakout": {
            "tp_pips": 16,
            "sl_pips": 8
          },
          "on_buy_revert": {
            "tp_pips": 12,
            "sl_pips": 7
          },
          "on_sell_revert": {
            "tp_pips": 12,
            "sl_pips": 7
          }
        }
      }
    }
  },
  "decision_rules": [
    {
      "name": "baseline_scalping",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_detected",
          "ob_detected"
        ],
        "phase_must_contain": [
          "trend"
        ],
        "min_confidence": 0.30
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter if bullish confluence and spread <= max_spread_points",
        "SELL": "enter if bearish confluence and spread <= max_spread_points"
      }
    },
    {
      "name": "range_scalping_microbreak",
      "priority": 2,
      "conditions": {
        "signal_must_contain": [
          "ob_detected"
        ],
        "phase_must_contain": [
          "range",
          "range_retail",
          "range_low_volatility"
        ],
        "min_confidence": 0.30
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish micro-break with OB confluence and spread <= max_spread_points",
        "SELL": "enter on bearish micro-break with OB confluence and spread <= max_spread_points"
      }
    }
  ],
  "smart_targets": {
    "take_profit": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 2.0,
      "fallback_rr": 1.8,
      "hard_max_points": 200
    },
    "stop_loss": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.2,
      "hard_min_points": 40,
      "hard_max_points": 120
    },
    "breakeven": {
      "enabled": true,
      "trigger_rr": 1.0,
      "lock_points": 20
    },
    "partial_take_profit": {
      "enabled": true,
      "at_rr": 1.0,
      "close_percent": 50
    },
    "trailing": {
      "enabled": false,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 1.2
    }
  },
  "exit_rules": {
    "time_based": {
      "enabled": true,
      "max_trade_minutes": 12
    },
    "invalidated_setup": {
      "enabled": true,
      "close_on_break_even_if_reenter": false
    },
    "news_exit": {
      "enabled": false,
      "minutes_before": 2,
      "minutes_after": 2
    }
  }
}