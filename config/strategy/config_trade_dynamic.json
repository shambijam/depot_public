{
  "strategy_name": "dynamic",
  "version": "2.0-compat",
  "tradeable_assets": [
    "EURUSD",
    "GBPUSD",
    "XAUUSD",
    "AUDUSD"
  ],
  "phase_detection": {
    "use_phase_observer": true,
    "lookback_window": 400,
    "volatility_threshold": 0.006,
    "volume_zscore": 0.35,
    "overrides": {
      "require_trend_detection": true,
      "prefer_trend_over_range": true,
      "min_lookback_bars": 500
    }
  },
  "magic_number": 51003,
  "risk_per_trade_percent": 0.6,
  "stop_loss_pips": 22,
  "take_profit_pips": 35,
  "decision_engine": {
    "thresholds": {
      "min_volatility": 0.006,
      "max_spread_points": 60,
      "min_volume_score": 0.35
    },
    "mtf": {
      "timeframes": [
        "M15",
        "H1",
        "H4"
      ],
      "required_agreements": 2
    },
    "trend_engine": {
      "ema_periods": [
        20,
        50,
        200
      ],
      "adx_min": 16,
      "rsi": {
        "overbought": 65,
        "oversold": 35
      },
      "confirm_breakout_ratio": 1.02,
      "pullback_depth_min": 0.382,
      "pullback_depth_max": 0.618
    },
    "range_engine": {
      "rsi_range": [
        40,
        60
      ],
      "max_atr_percent_of_price": 0.015,
      "mean_reversion": {
        "use": true,
        "entry_zscore": 1.0,
        "exit_zscore": 0.3
      }
    },
    "regime_overrides": {
      "trend": {
        "min_volatility": 0.006,
        "adx_min": 18,
        "confirmation_candles": 1
      },
      "range": {
        "min_volatility": 0.004,
        "use_mean_reversion": true,
        "confirmation_candles": 2
      },
      "range_accumulation": {
        "min_volatility": 0.004,
        "prefer_breakout_setups": true,
        "confirm_breakout_ratio": 1.03
      }
    },
    "scoring": {
      "base_score": 0.80,
      "trend_alignment_bonus": 0.15,
      "range_alignment_bonus": 0.10,
      "mtf_bonus_per_hit": 0.10,
      "best_opportunity_bonus": 0.10,
      "global_low_vol_penalty": -0.10,
      "high_spread_penalty": -0.20
    },
    "filters": {
      "avoid_major_news": true,
      "disable_on_weekends": true,
      "min_account_equity": 0,
      "allow_only_whitelist_assets": true
    },
    "risk": {
      "max_trades_per_day": 3,
      "cooldown_seconds_after_trade": 120,
      "skip_asset_if_spread_over_points": 60
    },
    "execution": {
      "order_type": "market",
      "confirmation_candles": 1,
      "slippage_points": 6,
      "max_parallel_positions": 1,
      "fallback_to_limit_on_pullback": true
    }
  },
  "decision_rules": [
    {
      "name": "baseline_dynamic",
      "priority": 1,
      "conditions": {
        "signal_must_contain": [
          "fvg_detected",
          "ob_detected"
        ],
        "phase_must_contain": [
          "trend",
          "range_accumulation",
          "range_retail"
        ],
        "min_confidence": 0.33
      },
      "order_type": "MARKET",
      "action_logic": {
        "BUY": "enter on bullish confluence w/ regime alignment",
        "SELL": "enter on bearish confluence w/ regime alignment"
      }
    }
  ],
  "smart_targets": {
    "take_profit": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 2.5,
      "fallback_rr": 1.8
    },
    "stop_loss": {
      "type": "atr",
      "atr_period": 14,
      "atr_multiplier": 1.5,
      "hard_min_points": 40
    },
    "breakeven": {
      "enabled": true,
      "trigger_rr": 1.2,
      "lock_points": 4
    },
    "partial_take_profit": {
      "enabled": true,
      "at_rr": 1.5,
      "close_percent": 40
    },
    "trailing": {
      "enabled": true,
      "type": "chandelier",
      "atr_period": 14,
      "atr_multiplier": 2.5
    }
  },
  "exit_rules": {
    "time_based": {
      "enabled": true,
      "max_trade_minutes": 720
    },
    "invalidated_setup": {
      "enabled": true,
      "close_on_break_even_if_reenter": true
    },
    "news_exit": {
      "enabled": true,
      "minutes_before": 2,
      "minutes_after": 2
    }
  }
}
