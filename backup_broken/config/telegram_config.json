{
    "telegram": {
        "enabled": false,
        "debug": false,
        "channels": {
            "telegram": false,
            "telegram_market_phase": false,
            "telegram_trade_confirmed": false,
            "telegram_trade_closed": false,
            "telegram_critical": false,
            "telegram_manual_override": false,
            "telegram_summary": false
        },
        "immediate_alert_types": [
            "telegram_critical",
            "telegram_manual_override"
        ],
        "parse_mode": "Markdown",
        "request_timeout_seconds": 15,
        "summary_interval_minutes": 8,
        "summary_max_queued_messages": 10,
        "templates": {
            "new_suggestion": "💡 Nouvelle Suggestion: {type} - {summary} | Priorité: {priority:.2f}",
            "pending_suggestion_reminder": "⏰ Rappel: Suggestion en attente - {summary} ({age} jours). Priorité: {priority:.2f}",
            "compliance_alert": "🚨 Alerte Conformité: {issue} | Item: {item} | Priorité: {priority:.2f} | Action: {action}",
            "trade_confirmed": "🚀 Trade Confirmé (IA): Symbole: {symbol} | Action: {action} | Volume: {volume} lots | Stratégie: {strategy}",
            "trade_closed": "📊 Trade Clôturé (IA): Symbole: {symbol} | P&L: ${pnl:.2f} ({status}) | Stratégie: {strategy}",
            "manual_override": "⚠️ **INTERVENTION MANUELLE REQUISE** ⚠️\nRaison: {reason}\nTrade: {action} {asset} {volume} lots\nStratégie: {strategy_type} | Confiance IA: {confidence_score:.2f}",
            "summary_header": "--- **Résumé Périodique SNIPER_X** ---\n`{time}` | Compte: `{account_id}` ({broker})",
            "trade_execution": {
                "executed": "✅ Ordre exécuté: {action_str} {volume} {symbol} @ {price}",
                "failed": "❌ Échec ordre: {action_str} {symbol}. Raison: {message}. Code: {retcode}",
                "pending_manual_approval": "✋ Ordre en attente: {action_str} {volume} {symbol}. Volume élevé. Approuver manuellement."
            }
        }
    }
}