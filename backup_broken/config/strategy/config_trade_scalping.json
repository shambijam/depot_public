        "require_bias": true,
        "min_delta_threshold": 50,
        "poc_weight": 0.4,
        "coherence_thresholds": {
          "strong": 0.75,
          "moderate": 0.65,
          "weak": 0.55
        },
        "analysis_windows": {
          "delta_coherence_bars": 3,
          "volume_avg_bars": 6,
          "lookback_bars": 10,
          "comment": "Fenêtres OPTIMISÉES scalping burst - Rapport 31 DEC 2025 (coherence 10→3, volume 14→6, lookback 20→10)"
        },
        "volume_ratio_classification": {
          "spike": 1.8,
          "elevated": 1.4,
          "above_average": 1.15,
          "normal": 0.85,
          "moderate": 0.6
        },
        "total_score_status": {
          "strong_threshold": 28.0,
          "moderate_threshold": 14.0,
          "max_score": 50.0
        },
        "absorption_ratios": {
          "very_bullish": 0.72,
          "bullish": 0.58,
          "slightly_bullish": 0.52,
          "neutral": 0.50,
          "slightly_bearish": 0.48,
          "bearish": 0.42,
          "very_bearish": 0.28
        }
      },
      "decision": {
        "min_orderflow_score": 75,
        "require_timing_pass": true,
        "max_spread_pts": 15,
        "min_confidence": 0.70,
        "comment": "06 JAN 2026 QUALITÉ: Seuils augmentés (70→75, 0.65→0.70) pour trades plus sélectifs"
      }
