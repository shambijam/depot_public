  "exit_rules": {
    "managed_by": "sltp"
  },
  "phase_detection": {
    "use_phase_observer": false,
    "allowed_phases": [
      "trending_retail_bull",
      "trending_retail_bear",
      "liquidity_eqh_eql",
      "transitional"
