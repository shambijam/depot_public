        "veto_hours_gmt": [
          9,
          10,
          11,
          12,
          17,
          18,
          19,
          20,
          21,
          22,
          23
        ],
        "min_tick_rate": 1.0,
        "min_coverage_s": 5.0,
        "max_tick_rate": 200.0,
        "max_spread_pips": 1.5,
        "comment_coverage_fix": "05 JAN 2026 FIX: min_coverage_s=5s aligné avec fenêtre glissante 8s (vs 40s ancien pour M1 60s)"
      },
      "blocked_phases": {
        "enabled": true,
        "description": "14 JAN 2026: ACTIF - Détection de phase à corriger pour temps réel",
        "phases": [
          "range",
          "accumulation",
          "range_accumulation",
          "range_distribution",
          "high_volatility_chaos"
        ],
        "comment": "VETO DÉSACTIVÉ - La détection de phase ne suit pas les mouvements rapides"
      },
      "orderflow_v6": {
        "enabled": true,
        "description": "Source unique de signaux - Détection liquidité institutionnelle",
        "delta_abs_min": 100.0,
        "decision_thresholds": {
          "excellent": 85,
          "good": 75,
          "moderate": 60,
          "hold_below": 60
